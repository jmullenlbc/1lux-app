node_modules/
.next/
.env
.env.local
# Runtime upload scratch at the repo root only. This rule used to read
# "uploads/", with no leading slash, which git applies to a directory of that
# name ANYWHERE in the tree — so src/app/api/uploads/ was silently excluded and
# the direct-to-S3 presign route was never committed or deployed. The route
# existed locally, worked locally, and returned 404 in production. Keep the
# leading slash.
/uploads/
dev.log
.dev.log
sk-ant-api03*.txt
*.db
deploy-log.json
public/pdf.worker.min.mjs

# Local math-testing scratch space (Claude-generated test scripts).
# Promote individual scripts out of this folder when they're ready to commit
# as proper regression tests.
_tests/
PLANNING/
.tmp-proposals/

# Stray local debug files that have accidentally been committed before.
# These patterns catch the common Windows-path-as-filename mistakes and
# generic temp logs without being so broad they hide intentional files.
C\:*
*tempdevserver*
*temp-devserver*
devserver.log
# start-dev.ps1 writes the dot-prefixed name, which the line above never matched.
.devserver.log
dev-server.log

# MCP audit log — the local JSONL fallback sink (src/lib/mcp/audit.js).
# Records who queried what through /api/mcp. Never committed: it is a record of
# real reads against the dev database, and in production the sink is a table.
.mcp-audit/

# AgentRun ledger — the local JSONL fallback sink (src/lib/agent/ledger.js).
# One row per model call: task, model, tokens, latency, project and user ids.
# No prompts or completions, but still an operational record of real activity
# against the dev database. Same rule as above; in production the sink is a table.
.agent-runs/

# Local stand-in for S3 while developing (drawing intake working files).
# Rooted so it can only ever match the folder at the repo root -- a bare
# "uploads/" line once swallowed src/app/api/uploads and shipped a 404 to prod.
/.intake-dev/
