// ── Change Order Matrix ───────────────────────────────────────────────────────

model ChangeOrder {
  id           String                     @id @default(cuid())
  projectId    String
  project      Project                    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  coNumber     String                     // auto-assigned: CO-00001, CO-00002, ...
  title        String
  date         DateTime                   @default(now())
  status       String                     @default("DRAFT")  // DRAFT | SENT | APPROVED
  notes        String?
  createdById  String
  createdBy    User                       @relation("COCreator", fields: [createdById], references: [id])
  createdAt    DateTime                   @default(now())
