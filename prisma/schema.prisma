  id            String   @id @default(cuid())
  clientId      String
  client        Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  typeCode      String   @default("") // 'C1','D2','P1','X3'
  location      String   @default("") // UNITS | CORRIDOR | GARAGE | BOH | AMENITY | EXTERIOR
  description   String   @default("")
  imageKey      String? // approved product picture (carried from the option)
  priceTarget   Float? // target price (carried from the option)
  productUrl    String?
  manufacturer  String? // optional; exact SKU picked per project
  catalogNumber String?
  finish        String?
  cct           String?
  lumens        String?
  wattage       String?
  voltage       String?
  dimming       String?
  mounting      String?
  notes         String?
  optionId      String? // provenance: the approved ClientProductOption this came from
  sortOrder     Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([clientId])
}

