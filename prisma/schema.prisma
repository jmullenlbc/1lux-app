model NotificationLog {
  id               String    @id @default(cuid())
  project_id       String
  project          Project   @relation(fields: [project_id], references: [id], onDelete: Cascade)
  notificationType String
  audience         String
  recipientEmail   String?
  sentAt           DateTime  @default(now())
  openedAt         DateTime?
  openToken        String    @unique @default(cuid())
  dedupeKey        String?
  payload          String    @default("{}")

  @@index([project_id])
  @@index([dedupeKey])
}

model NotificationQueue {
  id               String   @id @default(cuid())
  project_id       String
  project          Project  @relation(fields: [project_id], references: [id], onDelete: Cascade)
  notificationType String
  audience         String   @default("EXTERNAL")
  recipientEmail   String
  payload          String   @default("{}")
  createdAt        DateTime @default(now())
}

model PortalUser {
  id            String                   @id @default(cuid())
  email         String                   @unique
  passwordHash  String
  name          String
  role          String                   @default("EXTERNAL")
  createdAt     DateTime                 @default(now())
