generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                 String                     @id @default(cuid())
  email              String                     @unique
  name               String?
  passwordHash       String?
  role               String                     @default("USER")
  // Roles: SUPER_ADMIN | COMPANY_ADMIN | USER | CLIENT_VIEWER
  // Legacy roles still supported: ILC_ADMIN (=SUPER_ADMIN), ADMIN (=COMPANY_ADMIN)
  permissions        String                     @default("{}") // JSON: { projects, clients, preCon, manufacturers, admin, knowledgeBase }
  mustChangePassword Boolean                    @default(false)
  isActive           Boolean                    @default(true)
  inviteToken        String?                    @unique
  inviteExpiry       DateTime?
  dashboardConfig    String? // JSON: { version, widgets: [{id, order, size?}] }
  createdAt          DateTime                   @default(now())
  updatedAt          DateTime                   @updatedAt
  invitedById        String?
  projects           Project[]
  clients            Client[]
  assignedProjects   ProjectAssignee[]
  uploadedFiles      ProjectFile[]
  projectAccess      ProjectAccess[]
  standardsCreated   DesignStandard[]           @relation("KBCreator")
  standardsUpdated   DesignStandard[]           @relation("KBUpdater")
  ownedDeals         Deal[]                     @relation("DealOwner")
  createdDeals       Deal[]                     @relation("DealCreator")
  salesNotes         SalesNote[]                @relation("SalesNoteCreator")
  publishedSchedules FixtureSchedule[]          @relation("SchedulePublisher")
  pushedBidMatrices  DesignBidMatrix[]          @relation("BidPusher")
  tasksCreated       Task[]                     @relation("TaskCreator")
  tasksAssigned      Task[]                     @relation("TaskAssignee")
  dashboards         Dashboard[]                @relation("DashboardCreator")
  standardsAnswers   ClientStandardsAnswer[]    @relation("AnsweredByUser")
  standardsOverrides ProjectStandardsOverride[] @relation("OverrideActivator")
  confirmedFixtures  PlacedFixture[]            @relation("FixtureConfirmer")
  ownedClients       Client[]                   @relation("ClientOwner")
  alerts             UserAlert[]
}

model UserAlert {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String
  title     String
  message   String
  link      String?
  isRead    Boolean  @default(false)
  dedupeKey String?  @unique
  createdAt DateTime @default(now())
}

model Task {
  id          String           @id @default(cuid())
  title       String
  description String?
  status      String           @default("TODO") // TODO | IN_PROGRESS | IN_REVIEW | DONE
  priority    String           @default("MEDIUM") // LOW | MEDIUM | HIGH | URGENT
  assigneeId  String?
  createdById String
  dueDate     DateTime?
  tags        String           @default("[]") // JSON string array of menu tag ids
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  assignee    User?            @relation("TaskAssignee", fields: [assigneeId], references: [id])
  createdBy   User             @relation("TaskCreator", fields: [createdById], references: [id])
  attachments TaskAttachment[]
}

model TaskAttachment {
  id           String   @id @default(cuid())
  taskId       String
  task         Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  originalName String
  storedPath   String
  mimeType     String?
  size         Int
  createdAt    DateTime @default(now())
}

model KbCategory {
  id        String   @id @default(cuid())
  key       String   @unique
  label     String
  desc      String   @default("")
  color     String   @default("slate")
  icon      String   @default("📁")
  position  Int      @default(0)
  isBuiltIn Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model DesignStandard {
  id          String   @id @default(cuid())
  category    String
  title       String
  content     String
  severity    String   @default("REQUIRED") // REQUIRED | RECOMMENDED | NOTE
  tags        String   @default("[]")
  sourceUrl   String?
  isActive    Boolean  @default(true)
  createdById String
  updatedById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdBy   User     @relation("KBCreator", fields: [createdById], references: [id])
  updatedBy   User?    @relation("KBUpdater", fields: [updatedById], references: [id])
}

model Client {
  id           String @id @default(cuid())
  clientNumber Int?   @unique
  name         String
  type         String @default("developer")
  locationType String @default("standalone")

  email   String?
  phone   String?
  website String?
  address String?
  city    String?
  state   String?

  linkedIn            String?
  primaryContact      String?
  primaryContactTitle String?
  primaryContactEmail String?
  primaryContactPhone String?

  notes String?

  tier          String?
  markets       String  @default("[]")
  developerType String?
  orgTypes      String  @default("[]")

  ownerId          String?
  owner            User?                   @relation("ClientOwner", fields: [ownerId], references: [id])
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt
  createdById      String
  createdBy        User                    @relation(fields: [createdById], references: [id])
  projects         Project[]
  contacts         ClientContact[]
  kbSections       ClientKBSection[]
  deals            Deal[]
  crmContacts      Contact[]
  salesNotes       SalesNoteClient[]
  standardsAnswers ClientStandardsAnswer[]
  playbook         ClientPlaybook?
  signals          MarketSignal[]
  aliases          ClientAlias[]
}

model ClientPlaybook {
  id      String @id @default(cuid())
  clientId String @unique
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  // Section 1 — Scope & Relationships
  projectTypes    String?  // JSON array: ['BTR','GARDEN','PODIUM','HIGHRISE','LIHTC']
  projectsPerYear Int?
  primaryMarkets  String?
  costTierNotes   String?
  architectRel    String?  // JSON: { exists, firm, contact, introStatus, notes }
  eeRel           String?  // JSON: { exists, firm, contact, introStatus, notes }
  gcRel           String?  // JSON: { exists, firm, contact, introStatus, gcModel, notes }
  primaryContactId  String?
  approverContactId String?

  // Section 3 — General Process
  engagementTiming  String?  // SD|DD|CD|BID|VARIES
  submittalPlatform String?  // EMAIL|PROCORE|BUILDING_CONNECTED|BLUEBEAM|OTHER
  coTolerance       String?  // TIGHT|NORMAL|FLEXIBLE
  mgmtStructure     String?  // CENTRAL|REGIONAL|MIXED
  hasDesignTeam     Boolean  @default(false)
  processNotes      String?

  // Section 4 — Timeframes
  engagementLeadTime     String?  // 6_PLUS|3_TO_6|1_TO_3|AT_GB|VARIES
  budgetCadence          String?  // EACH_PHASE|CD_ONLY|AS_REQUESTED|QUARTERLY
  submittalTurnaround    String?  // 3_DAYS|5_DAYS|2_WEEKS|NONE
  typicalSdToCd          String?
  rfiResponseExpectation String?  // SAME_DAY|24HR|48HR|NOT_SPECIFIED
  timeframeNotes         String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ClientContact {
  id        String   @id @default(cuid())
  clientId  String
  client    Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  name      String
  title     String?
  email     String?
  phone     String?
  createdAt DateTime @default(now())
}

model ClientKBSection {
  id          String               @id @default(cuid())
  clientId    String
  client      Client               @relation(fields: [clientId], references: [id], onDelete: Cascade)
  title       String               @default("Untitled Section")
  content     String               @default("")
  sortOrder   Int                  @default(0)
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
  attachments ClientKBAttachment[]
}

model ClientKBAttachment {
  id           String          @id @default(cuid())
  sectionId    String
  section      ClientKBSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  originalName String
  storedPath   String
  mimeType     String?
  size         Int
  createdAt    DateTime        @default(now())
}

model Project {
  id                       String    @id @default(cuid())
  projectNumber            Int?      @unique
  name                     String
  buildingType             String?
  location                 String?
  contactEmail             String?
  address                  String?
  date                     String?
  budgetType               String    @default("conceptual")
  budgetNumber             String?   @unique
  budgetSentDate           DateTime?
  phase                    String    @default("sd")
  city                     String?
  state                    String?
  status                   String    @default("DRAFT")
  serviceType              String?
  peerReviewMatrixType     String    @default("PEER_REVIEW")
  flagged                  Boolean   @default(false)
  flagNote                 String?
  contractValue            Float?
  contractSignedDate       String?
  designContractValue      Float?
  designContractSignedDate String?
  constructionStartDate    String?
  mepRoughInDate           String?
  constructionEndDate      String?
  currentStep              String    @default("project-data")
  completedSteps           String    @default("[]")
  pricingSnapshot          String?
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt
  createdById              String
  createdBy                User      @relation(fields: [createdById], references: [id])
  clientId                 String?
  client                   Client?   @relation(fields: [clientId], references: [id])

  projectData         ProjectData?
  responses           QuestionnaireResponse[]
  shares              ProjectShare[]
  peerReviewItems     PeerReviewItem[]
  assignees           ProjectAssignee[]
  files               ProjectFile[]
  projectAccess       ProjectAccess[]
  meetingNotes        MeetingNote[]
  submittalTracker    SubmittalTracker?
  activities          ProjectActivity[]
  chatConversations   ChatConversation[]
  linkedDeals         Deal[]                      @relation("DealProject")
  fixtureSchedules    FixtureSchedule[]
  designBidMatrices   DesignBidMatrix[]
  standardsOverrides  ProjectStandardsOverride[]
  placedFixtures      PlacedFixture[]
  shipments           Shipment[]
  notificationConfigs ProjectNotificationConfig[]
  notificationLogs    NotificationLog[]
  notificationQueue   NotificationQueue[]
  externalContacts    ProjectExternalContact[]
}

model ProjectFile {
  id             String          @id @default(cuid())
  projectId      String
  project        Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tab            String
  fileType       String?
  originalName   String
  storedPath     String
  size           Int
  mimeType       String?
  tags           String?
  textContent    String?
  takeoffData    String?
  parsedAmount   Float?
  analysisData   String?
  uploadedById   String
  uploadedBy     User            @relation(fields: [uploadedById], references: [id])
  createdAt      DateTime        @default(now())
  placedFixtures PlacedFixture[]
}

model ProjectAssignee {
  id        String   @id @default(cuid())
  projectId String
  userId    String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([projectId, userId])
}

model ProjectAccess {
  id        String   @id @default(cuid())
  userId    String
  projectId String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, projectId])
}

model ProjectData {
  id        String  @id @default(cuid())
  projectId String  @unique
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  grossSf             Float?
  unitsSf             Float?
  numUnits            Int?
  numBedrooms         Int?
  numBalconies        Int?
  numBathrooms        Int?
  numVanities         Int?
  numEgressStairwells Int?
  numFans             Int?
  numAccentDownlights Int?

  numSurfaceParking Int?
  numCarports       Int?
  numGarages        Int?
  numExteriorDoors  Int?

  exteriorAmenitySf   Float?
  lotSf               Float?
  buildingFootprintSf Float?
  corridorSf          Float?
  interiorAmenitySf   Float?
  garageSf            Float?
  bohSf               Float?

  clientInitialBudget Float?
  freightPct          Float?
  warehousingPct      Float?
  salesTaxPct         Float?
  marginPct           Float?
}

model ProjectShare {
  id           String    @id @default(cuid())
  projectId    String
  project      Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  token        String    @unique @default(cuid())
  sentTo       String    @default("[]")
  message      String?
  sentAt       DateTime  @default(now())
  sentById     String
  viewCount    Int       @default(0)
  lastViewedAt DateTime?
  viewLog      String    @default("[]")
}

model SystemConfig {
  id          String   @id @default(cuid())
  key         String   @unique
  value       String
  updatedAt   DateTime @updatedAt
  updatedById String?
}

model PeerReviewItem {
  id                 String   @id @default(cuid())
  projectId          String
  project            Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  section            String   @default("units")
  typeCode           String?
  description        String?
  location           String   @default("")
  notes              String   @default("")
  internalNotes      String   @default("")
  qty                Float?
  specManufacturer   String?
  specModel          String?
  specDetails        String?
  prevQty            Float?
  qtyType            String?
  altChoices         String?
  propManufacturer   String?
  propManufacturerId String?
  propModel          String?
  propProductId      String?
  propUnitDN         Float?
  propUnitPrice      Float?
  repName            String?
  repEmail           String?
  rfqStatus          String?
  unitSavings        Float?
  totalSavings       Float?
  sortOrder          Int      @default(0)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

model QuestionnaireResponse {
  id          String   @id @default(cuid())
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  section     String
  questionKey String
  answerValue String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([projectId, section, questionKey])
}

model SubmittalTracker {
  id            String                @id @default(cuid())
  projectId     String                @unique
  project       Project               @relation(fields: [projectId], references: [id], onDelete: Cascade)
  specSection   String?
  reviewerRoles String                @default("[\"ILC\",\"Developer\",\"Architect\",\"LA\",\"ID\",\"EE\"]")
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt
  items         SubmittalItem[]
  submissions   SubmittalSubmission[]
}

model SubmittalItem {
  id                String                 @id @default(cuid())
  trackerId         String
  tracker           SubmittalTracker       @relation(fields: [trackerId], references: [id], onDelete: Cascade)
  typeCode          String
  description       String?
  location          String?
  sortOrder         Int                    @default(0)
  createdAt         DateTime               @default(now())
  versions          SubmittalItemVersion[]
  shipmentLineItems ShipmentLineItem[]
}

model SubmittalSubmission {
  id            String                 @id @default(cuid())
  trackerId     String
  tracker       SubmittalTracker       @relation(fields: [trackerId], references: [id], onDelete: Cascade)
  name          String
  submittedDate String?
  notes         String?
  createdAt     DateTime               @default(now())
  versions      SubmittalItemVersion[]
}

model SubmittalItemVersion {
  id           String              @id @default(cuid())
  itemId       String
  item         SubmittalItem       @relation(fields: [itemId], references: [id], onDelete: Cascade)
  submissionId String
  submission   SubmittalSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  manufacturer String?
  modelNumber  String?
  createdAt    DateTime            @default(now())
  reviews      SubmittalReview[]
}

model SubmittalReview {
  id           String               @id @default(cuid())
  versionId    String
  version      SubmittalItemVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)
  reviewerRole String
  reviewerName String?
  status       String
  dateNoted    String?
  notes        String?
  createdAt    DateTime             @default(now())
  createdById  String?
}

model ProjectActivity {
  id          String   @id @default(cuid())
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId      String
  userName    String?
  userEmail   String?
  type        String
  description String
  metadata    String?
  createdAt   DateTime @default(now())
}

model ChatConversation {
  id        String        @id @default(cuid())
  projectId String
  project   Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title     String?
  createdAt DateTime      @default(now())
  messages  ChatMessage[]
}

model ChatMessage {
  id             String           @id @default(cuid())
  conversationId String
  conversation   ChatConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role           String
  content        String
  createdAt      DateTime         @default(now())
}

model MeetingNote {
  id                String   @id @default(cuid())
  projectId         String
  project           Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title             String   @default("")
  content           String   @default("")
  meetingDate       String?
  meetingLink       String?
  attendees         String?
  isExternalVisible Boolean  @default(false)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model Manufacturer {
  id              String                @id @default(cuid())
  numericId       Int                   @unique
  name            String
  acctLastUpdated String?
  setupToSell     Boolean               @default(false)
  terms           String?
  credit          Float?
  notes           String?
  accountingEmail String?
  ffa             Float?
  paymentInfo     String?
  website         String?
  mainPhone       String?
  address         String?
  address2        String?
  city            String?
  state           String?
  zip             String?
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt
  products        ManufacturerProduct[]
}

model ManufacturerProduct {
  id             String       @id @default(cuid())
  numericId      Int          @unique
  manufacturerId String
  manufacturer   Manufacturer @relation(fields: [manufacturerId], references: [id], onDelete: Cascade)
  partNumber     String
  description    String?
  finish         String?
  cct            String?
  wattage        Float?
  dimming        String?
  voltage        String?
  mounting       String?
  fixtureType    String?
  cost           Float?
  salePrice      Float?
  notes          String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([manufacturerId, partNumber])
}

model Deal {
  id                String    @id @default(cuid())
  dealNumber        Int       @unique
  title             String
  pipeline          String
  stage             String
  dealStatus        String    @default("OPEN")
  designStatus      String    @default("OPEN")
  projectStatus     String    @default("ACTIVE")
  city              String?
  state             String?
  buildingType      String?
  numberOfUnits     Int?
  projectType       String?
  serviceType       String?
  totalRevenue      Float?
  designFeeTotal    Float?
  probability       Int       @default(50)
  expectedOrderDate DateTime?
  notes             String?
  nextActionText    String?
  nextActionDue     DateTime?
  wonAt             DateTime?
  lostAt            DateTime?
  lostReason        String?

  linkedDealId    String?
  linkedDeal      Deal?    @relation("DealLink", fields: [linkedDealId], references: [id])
  linkedDeals     Deal[]   @relation("DealLink")
  linkedProjectId String?
  linkedProject   Project? @relation("DealProject", fields: [linkedProjectId], references: [id])
  clientId        String?
  client          Client?  @relation(fields: [clientId], references: [id], onDelete: SetNull)
  ownerId         String?
  owner           User?    @relation("DealOwner", fields: [ownerId], references: [id])
  createdById     String
  createdBy       User     @relation("DealCreator", fields: [createdById], references: [id])
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  contacts   DealContact[]
  activities DealActivity[]
  salesNotes SalesNoteDeal[]
  signalTags MarketSignalDeal[]
}

model DealContact {
  id        String   @id @default(cuid())
  dealId    String
  deal      Deal     @relation(fields: [dealId], references: [id], onDelete: Cascade)
  contactId String
  contact   Contact  @relation(fields: [contactId], references: [id], onDelete: Cascade)
  role      String
  createdAt DateTime @default(now())

  @@unique([dealId, contactId])
}

model Contact {
  id            String        @id @default(cuid())
  contactNumber Int           @unique
  clientId      String?
  client        Client?       @relation(fields: [clientId], references: [id], onDelete: SetNull)
  name          String
  title         String?
  email         String?
  phone         String?
  notes         String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  dealContacts  DealContact[]
}

model SalesNote {
  id          String            @id @default(cuid())
  noteNumber  Int               @unique
  title       String            @default("")
  body        String            @default("")
  meetingDate DateTime?
  attendees   String            @default("[]")
  calendarRef String?
  createdById String
  createdBy   User              @relation("SalesNoteCreator", fields: [createdById], references: [id])
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  clients     SalesNoteClient[]
  deals       SalesNoteDeal[]
}

model SalesNoteClient {
  id          String    @id @default(cuid())
  salesNoteId String
  salesNote   SalesNote @relation(fields: [salesNoteId], references: [id], onDelete: Cascade)
  clientId    String
  client      Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())

  @@unique([salesNoteId, clientId])
}

model SalesNoteDeal {
  id          String    @id @default(cuid())
  salesNoteId String
  salesNote   SalesNote @relation(fields: [salesNoteId], references: [id], onDelete: Cascade)
  dealId      String
  deal        Deal      @relation(fields: [dealId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())

  @@unique([salesNoteId, dealId])
}

model DealActivity {
  id        String   @id @default(cuid())
  dealId    String
  deal      Deal     @relation(fields: [dealId], references: [id], onDelete: Cascade)
  userId    String
  userName  String?
  type      String
  body      String
  metadata  String?
  createdAt DateTime @default(now())
}

model FixtureSchedule {
  id                String                @id @default(cuid())
  projectId         String
  project           Project               @relation(fields: [projectId], references: [id], onDelete: Cascade)
  state             String                @default("DRAFT")
  version           Int                   @default(0)
  publishedAt       DateTime?
  publishedById     String?
  publishedBy       User?                 @relation("SchedulePublisher", fields: [publishedById], references: [id])
  submissionTag     String?
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt
  items             FixtureScheduleItem[]
  designBidMatrices DesignBidMatrix[]
}

model FixtureScheduleItem {
  id             String                @id @default(cuid())
  scheduleId     String
  schedule       FixtureSchedule       @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  type           String                @default("")
  location       String                @default("")
  description    String                @default("")
  manufacturer   String?
  catalogNumber  String?
  finish         String?
  cct            String?
  lumens         String?
  wattage        String?
  voltage        String?
  dimming        String?
  mounting       String?
  notes          String?
  internalNotes  String?
  sortOrder      Int                   @default(0)
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt
  designBidItems DesignBidMatrixItem[]
}

model DesignBidMatrix {
  id               String                @id @default(cuid())
  projectId        String
  project          Project               @relation(fields: [projectId], references: [id], onDelete: Cascade)
  sourceScheduleId String
  sourceSchedule   FixtureSchedule       @relation(fields: [sourceScheduleId], references: [id], onDelete: Cascade)
  version          Int                   @default(1)
  createdAt        DateTime              @default(now())
  pushedById       String
  pushedBy         User                  @relation("BidPusher", fields: [pushedById], references: [id])
  submissionTag    String?
  matrixType       String                @default("DESIGN_BID")
  changeSummary    String?
  items            DesignBidMatrixItem[]
}

model Dashboard {
  id          String            @id @default(cuid())
  name        String
  isDefault   Boolean           @default(false)
  createdById String
  createdBy   User              @relation("DashboardCreator", fields: [createdById], references: [id])
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  widgets     DashboardWidget[]
}

model DashboardWidget {
  id          String    @id @default(cuid())
  dashboardId String
  dashboard   Dashboard @relation(fields: [dashboardId], references: [id], onDelete: Cascade)
  name        String
  category    String
  metric      String
  viewBy      String
  segmentBy   String?
  filters     String    @default("[]")
  position    Int
  width       String    @default("HALF")
  createdAt   DateTime  @default(now())
}

model MasterType {
  code           String          @id
  description    String
  fixture_family String
  symbol_svg     String          @default("")
  is_unit_type   Boolean         @default(false)
  is_active      Boolean         @default(true)
  fixtureTypes   FixtureType[]
  ilcSpecs       ILCSpec[]
  placedFixtures PlacedFixture[]
}

model FixtureType {
  code           String                  @id
  master_type_id String
  masterType     MasterType              @relation(fields: [master_type_id], references: [code])
  family         String
  description    String?
  is_active      Boolean                 @default(true)
  placedFixtures PlacedFixture[]
  clientAnswers  ClientStandardsAnswer[]
}

model ILCSpec {
  id             String     @id @default(cuid())
  master_type_id String
  masterType     MasterType @relation(fields: [master_type_id], references: [code])
  family         String
  description    String
  manufacturer   String
  base_catalog   String
  full_catalog   String?
  variables      String?
  budget_cost    Float?
  design_notes   String?
  use_context    String     @default("[]")
  is_default     Boolean    @default(false)
  tier           String     @default("STANDARD")
  is_active      Boolean    @default(true)
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
}

model ClientStandardsAnswer {
  id             String       @id @default(cuid())
  clientId       String
  client         Client       @relation(fields: [clientId], references: [id], onDelete: Cascade)
  section        String
  subsection     String
  question_key   String
  input_type     String
  fixture_family String?
  answer_value   String?
  answer_note    String?
  type_code      String?
  fixtureType    FixtureType? @relation(fields: [type_code], references: [code])
  resolved_sku   String?
  adder_flag     Boolean      @default(false)
  adder_prompt   String?
  reference_key  String?
  projectType    String       @default("")  // "" = global | "BTR"|"GARDEN"|"PODIUM"|"HIGHRISE"|"LIHTC"
  region         String       @default("")  // "" = all regions | client-defined key e.g. "AZ_TX"
  source         String       @default("MANUAL")  // MANUAL | CASCADE
  answeredById   String?
  answeredBy     User?        @relation("AnsweredByUser", fields: [answeredById], references: [id])
  answered_at    DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([clientId, question_key, projectType, region])
}

model ProjectStandardsOverride {
  id             String   @id @default(cuid())
  projectId      String
  project        Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  question_key   String
  override_value String
  activatedById  String
  activatedBy    User     @relation("OverrideActivator", fields: [activatedById], references: [id])
  activated_at   DateTime @default(now())
  note           String?
}

model PlacedFixture {
  id             String       @id @default(cuid())
  drawing_id     String
  drawing        ProjectFile  @relation(fields: [drawing_id], references: [id], onDelete: Cascade)
  projectId      String
  project        Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  page_number    Int          @default(1)
  x              Float
  y              Float
  ai_suggested_x Float?
  ai_suggested_y Float?
  master_type_id String
  masterType     MasterType   @relation(fields: [master_type_id], references: [code])
  type_code      String?
  fixtureType    FixtureType? @relation(fields: [type_code], references: [code])
  status         String       @default("SUGGESTED")
  unit_type      String?
  room_type      String?
  confirmedById  String?
  confirmedBy    User?        @relation("FixtureConfirmer", fields: [confirmedById], references: [id])
  confirmed_at   DateTime?
  note           String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
}

model DesignBidMatrixItem {
  id                 String               @id @default(cuid())
  matrixId           String
  matrix             DesignBidMatrix      @relation(fields: [matrixId], references: [id], onDelete: Cascade)
  sourceItemId       String?
  sourceItem         FixtureScheduleItem? @relation(fields: [sourceItemId], references: [id])
  type               String               @default("")
  description        String               @default("")
  locationTag        String?
  manufacturer       String?
  partNumber         String?
  salesRep           String?
  rfqStatus          String?
  qty                Int?
  qtyType            String?
  dnPerUnit          Float?
  cnPerUnit          Float?
  cnTotal            Float?
  pricingLastUpdated DateTime?
  notes              String?
  internalNotes      String?
  sortOrder          Int                  @default(0)
  isArchived         Boolean              @default(false)
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
}

model Shipment {
  id             String             @id @default(cuid())
  project_id     String
  project        Project            @relation(fields: [project_id], references: [id], onDelete: Cascade)
  manufacturer   String
  poDate         DateTime?
  leadTimeWeeks  String?
  esdDate        DateTime?
  trackingNumber String?
  deliveredDate  DateTime?
  status         String             @default("PO_PLACED")
  notes          String?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  lineItems      ShipmentLineItem[]
}

model ShipmentLineItem {
  id              String         @id @default(cuid())
  shipment_id     String
  shipment        Shipment       @relation(fields: [shipment_id], references: [id], onDelete: Cascade)
  fixtureType     String
  description     String
  catalogNo       String?
  qty             Int            @default(1)
  fixtureStatus   String?
  notes           String?
  submittalItemId String?
  submittalItem   SubmittalItem? @relation(fields: [submittalItemId], references: [id], onDelete: SetNull)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
}

model ProjectNotificationConfig {
  id               String   @id @default(cuid())
  project_id       String
  project          Project  @relation(fields: [project_id], references: [id], onDelete: Cascade)
  notificationType String
  externalEmails   String   @default("")
  enabled          Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@unique([project_id, notificationType])
}

model NotificationLog {
  id               String    @id @default(cuid())
  project_id       String
  project          Project   @relation(fields: [project_id], references: [id], onDelete: Cascade)
  notificationType String
  audience         String
  recipientEmail   String?
  sentAt           DateTime  @default(now())
  openedAt         DateTime?
  openToken        String    @unique @default(cuid())
  dedupeKey        String?
  payload          String    @default("{}")

  @@index([project_id])
  @@index([dedupeKey])
}

model NotificationQueue {
  id               String   @id @default(cuid())
  project_id       String
  project          Project  @relation(fields: [project_id], references: [id], onDelete: Cascade)
  notificationType String
  audience         String   @default("EXTERNAL")
  recipientEmail   String
  payload          String   @default("{}")
  createdAt        DateTime @default(now())
}

model PortalUser {
  id            String                   @id @default(cuid())
  email         String                   @unique
  passwordHash  String
  name          String
  role          String                   @default("EXTERNAL")
  createdAt     DateTime                 @default(now())
  updatedAt     DateTime                 @updatedAt
  projectAccess ProjectExternalContact[]
}

model ProjectExternalContact {
  id                       String      @id @default(cuid())
  project_id               String
  project                  Project     @relation(fields: [project_id], references: [id], onDelete: Cascade)
  portalUserId             String?
  portalUser               PortalUser? @relation(fields: [portalUserId], references: [id], onDelete: SetNull)
  name                     String
  email                    String
  role                     String
  canViewShipSchedule      Boolean     @default(false)
  canViewSubmittals        Boolean     @default(false)
  canViewMeetings          Boolean     @default(false)
  canViewContracts         Boolean     @default(false)
  canViewConstructionSched Boolean     @default(false)
  canViewChangeOrders      Boolean     @default(false)
  canViewBudgets           Boolean     @default(false)
  inviteToken              String?     @unique
  inviteTokenExpiresAt     DateTime?
  invitedAt                DateTime?
  acceptedAt               DateTime?
  createdAt                DateTime    @default(now())
  updatedAt                DateTime    @updatedAt

  @@unique([project_id, email])
}

// ── Market Intelligence ───────────────────────────────────────────────────────

model MarketSource {
  id               String         @id @default(cuid())
  name             String         @unique
  feedUrl          String
  siteUrl          String
  sourceType       String         @default("RSS")
  projectTypes     String         @default("[]") // JSON array: ["MARKET_RATE","AFFORDABLE","STUDENT_HOUSING","SENIOR_LIVING"]
  isActive         Boolean        @default(true)
  lastPolledAt     DateTime?
  pollingFrequency String         @default("DAILY") // "DAILY" | "WEEKLY"
  notes            String?
  signals          MarketSignal[]
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
}

model MarketSignal {
  id             String            @id @default(cuid())
  sourceId       String
  source         MarketSource      @relation(fields: [sourceId], references: [id])
  title          String
  summary        String?
  url            String?
  publishedAt    DateTime?
  signalType     String            @default("NEWS") // NEWS | GROUNDBREAKING | FINANCING | ACQUISITION | DEVELOPER_AWARD
  projectType    String?           // MARKET_RATE | AFFORDABLE | STUDENT_HOUSING | SENIOR_LIVING
  developerNames String?           // JSON array of extracted org names
  linkedClientId String?
  linkedClient   Client?           @relation(fields: [linkedClientId], references: [id], onDelete: SetNull)
  matchScore     Float?
  matchStatus    String            @default("UNREVIEWED") // AUTO_LINKED | SUGGESTED | UNREVIEWED | CONFIRMED | REJECTED
  reviewStatus   String            @default("UNREVIEWED") // UNREVIEWED | REVIEWED | CONVERTED | DISMISSED
  dealTags       MarketSignalDeal[]
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
}

model MarketSignalDeal {
  id        String       @id @default(cuid())
  signalId  String
  signal    MarketSignal @relation(fields: [signalId], references: [id], onDelete: Cascade)
  dealId    String
  deal      Deal         @relation(fields: [dealId], references: [id], onDelete: Cascade)
  taggedById String
  taggedAt  DateTime     @default(now())

  @@unique([signalId, dealId])
}

model ClientAlias {
  id              String   @id @default(cuid())
  clientId        String
  client          Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  aliasName       String
  normalizedAlias String
  createdById     String
  createdAt       DateTime @default(now())
}

model FuzzyMatchFeedback {
  id              String   @id @default(cuid())
  candidateName   String
  matchedClientId String?
  score           Float
  outcome         String   // CONFIRMED | REJECTED
  signalId        String
  userId          String
  createdAt       DateTime @default(now())
}
