  name                     String
  email                    String
  role                     String
  canViewShipSchedule      Boolean     @default(false)
  canViewSubmittals        Boolean     @default(false)
  canViewMeetings          Boolean     @default(false)
  canViewContracts         Boolean     @default(false)
  canViewConstructionSched Boolean     @default(false)
  canViewChangeOrders      Boolean     @default(false)
  canViewBudgets           Boolean     @default(false)
  inviteToken              String?     @unique
  inviteTokenExpiresAt     DateTime?
  invitedAt                DateTime?
  acceptedAt               DateTime?
  createdAt                DateTime    @default(now())
  updatedAt                DateTime    @updatedAt

  @@unique([project_id, email])
}

// ── Market Intelligence ───────────────────────────────────────────────────────

model MarketSource {
  id               String         @id @default(cuid())
  name             String         @unique
  feedUrl          String
  siteUrl          String
  sourceType       String         @default("RSS")
  // Which town this paper reports from. National trade press names companies;
  // only the local desk ever prints a project's name, so knowing which is which
  // is the difference between "we have 35 sources" and "we have coverage in
  // Houston". Keys live in src/lib/market-intel/sourceCatalog.js.
  market           String         @default("NATIONAL")
  projectTypes     String         @default("[]") // JSON array: ["MARKET_RATE","AFFORDABLE","STUDENT_HOUSING","SENIOR_LIVING"]
  isActive         Boolean        @default(true)
  lastPolledAt     DateTime?
  pollingFrequency String         @default("DAILY") // "DAILY" | "WEEKLY"
  notes            String?
  signals          MarketSignal[]
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
}

model MarketSignal {
  id                 String       @id @default(cuid())
  sourceId           String
  source             MarketSource @relation(fields: [sourceId], references: [id])
  title              String
  summary            String?
  url                String?
  publishedAt        DateTime?
  signalType         String       @default("NEWS") // NEWS | GROUNDBREAKING | FINANCING | ACQUISITION | DEVELOPER_AWARD
  projectType        String? // MARKET_RATE | AFFORDABLE | STUDENT_HOUSING | SENIOR_LIVING
  developerNames     String? // JSON array of extracted org names
  linkedClientId     String?
  linkedClient       Client?      @relation(fields: [linkedClientId], references: [id], onDelete: SetNull)
  // A signal names a JOB as often as it names a company — "Trailhead breaks
  // ground" is about a project, not about a developer. Without this the answer
  // to "any news on The Approach?" is unreachable: the client is linked and the
  // project never was.
  linkedProjectId    String?
  linkedProject      Project?     @relation(fields: [linkedProjectId], references: [id], onDelete: SetNull)
  projectMatchStatus String       @default("UNREVIEWED") // AUTO_LINKED | SUGGESTED | UNREVIEWED | CONFIRMED | REJECTED
  projectMatchScore  Float?
  matchScore         Float?
  matchStatus        String       @default("UNREVIEWED") // AUTO_LINKED | SUGGESTED | UNREVIEWED | CONFIRMED | REJECTED
  reviewStatus       String       @default("UNREVIEWED") // UNREVIEWED | REVIEWED | CONVERTED | DISMISSED
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt
}

model ClientAlias {
  id              String   @id @default(cuid())
  clientId        String
  client          Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  aliasName       String
  normalizedAlias String
  createdById     String
  createdAt       DateTime @default(now())
}

model FuzzyMatchFeedback {
  id              String   @id @default(cuid())
  candidateName   String
  matchedClientId String?
  score           Float
  outcome         String // CONFIRMED | REJECTED
  signalId        String
  userId          String
  createdAt       DateTime @default(now())
}

// ── Drawing Submissions ───────────────────────────────────────────────────────

// ── Fixture Schedule Share Links ─────────────────────────────────────────────

model FixtureScheduleShare {
  id           String    @id @default(cuid())
  projectId    String
  project      Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  token        String    @unique @default(cuid())
  permission   String    @default("view") // "view" | "edit"
  createdById  String
  createdBy    User      @relation("FixtureShareCreator", fields: [createdById], references: [id])
  createdAt    DateTime  @default(now())
  lastViewedAt DateTime?
}

model DrawingSubmission {
  id           String        @id @default(cuid())
  projectId    String
  project      Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  phaseTag     String? // SD | DD | CD | IFC | ASI | RFI | PERMIT | OTHER
  source       String        @default("EXTERNAL") // EXTERNAL | INTERNAL
  notes        String?
  uploadedById String
  uploadedBy   User          @relation("DrawingUploader", fields: [uploadedById], references: [id])
  createdAt    DateTime      @default(now())
  files        DrawingFile[]
  // Archived, never deleted (Mike, 2026-09-11: "drawings and budgets and products should be archive only").
  archivedAt   DateTime?
  archivedById String?
  archivedBy   User?         @relation("DrawingSubmissionArchiver", fields: [archivedById], references: [id], onDelete: SetNull)
}

model DrawingFile {
  id           String            @id @default(cuid())
  submissionId String
  submission   DrawingSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  fileName     String
  storedPath   String
  pageCount    Int?
  size         Int
  mimeType     String            @default("application/pdf")
  createdAt    DateTime          @default(now())
}

// ── Change Order Matrix ───────────────────────────────────────────────────────

model ChangeOrder {
  id           String                   @id @default(cuid())
  projectId    String
  project      Project                  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  coNumber     String // auto-assigned: CO-00001, CO-00002, ...
  title        String
  date         DateTime                 @default(now())
  status       String                   @default("DRAFT") // DRAFT | SENT | APPROVED
  notes        String?
  createdById  String
  createdBy    User                     @relation("COCreator", fields: [createdById], references: [id])
  createdAt    DateTime                 @default(now())
  updatedAt    DateTime                 @updatedAt
  optionGroups ChangeOrderOptionGroup[]
  sends        ChangeOrderSend[]
  shares       ChangeOrderShare[]
  rfi          RFI?                     @relation("COFromRFI", fields: [rfiId], references: [id])
  rfiId        String?                  @unique // set when CO is generated from an RFI substitution

  @@index([projectId])
}

model ChangeOrderOptionGroup {
  id            String                @id @default(cuid())
  changeOrderId String
  changeOrder   ChangeOrder           @relation(fields: [changeOrderId], references: [id], onDelete: Cascade)
  label         String                @default("Default")
  sortOrder     Int                   @default(0)
  isSelected    Boolean               @default(false)
  lineItems     ChangeOrderLineItem[]

  @@index([changeOrderId])
}

model ChangeOrderLineItem {
  id               String                 @id @default(cuid())
  optionGroupId    String
  optionGroup      ChangeOrderOptionGroup @relation(fields: [optionGroupId], references: [id], onDelete: Cascade)
  sortOrder        Int                    @default(0)
  fixtureType      String                 @default("")
  qty              Float                  @default(0)
  manufacturer     String?
  partNumber       String?
  description      String?
  originalDN       Float? // internal buy price — never shown to clients
  cnUnitPrice      Float                  @default(0)
  // TOTAL CN = qty × cnUnitPrice — calculated, never stored
  quoteReference   String?
  leadTime         String?
  notes            String?
  // Per-line option groups: alternate pricing rows for the same fixture type
  parentLineItemId String? // null = standalone or Option A root; set = sibling option
  isOptionRow      Boolean                @default(false) // true = part of a group
  optionLabel      String? // "Option A", "Option B", etc.
  isGroupSelected  Boolean                @default(false) // true = this option counts toward total (one per group)
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt

  @@index([optionGroupId])
  @@index([parentLineItemId])
}

model ChangeOrderSend {
  id            String      @id @default(cuid())
  changeOrderId String
  changeOrder   ChangeOrder @relation(fields: [changeOrderId], references: [id], onDelete: Cascade)
  sentById      String
  sentBy        User        @relation("COSender", fields: [sentById], references: [id])
  recipients    String // comma-separated email addresses
  notes         String?
  sentAt        DateTime    @default(now())

  @@index([changeOrderId])
}

model ChangeOrderShare {
  id            String      @id @default(cuid())
  changeOrderId String
  changeOrder   ChangeOrder @relation(fields: [changeOrderId], references: [id], onDelete: Cascade)
  token         String      @unique @default(cuid())
  createdById   String
  createdBy     User        @relation("COShareCreator", fields: [createdById], references: [id])
  lastViewedAt  DateTime?
  createdAt     DateTime    @default(now())

  @@index([changeOrderId])
}

// ── Email / Correspondence ────────────────────────────────────────────────────

model EmailAccount {
  id            String         @id @default(cuid())
  provider      String         @default("MOCK") // MOCK | MICROSOFT
  email         String         @unique
  displayName   String?
  accountType   String // USER | SHARED_MAILBOX
  inboxRole     String // PERSONAL | ORDERS | PRECON | DESIGN
  accessToken   String? // encrypted, Phase B only
  refreshToken  String? // encrypted, Phase B only
  tokenExpiry   DateTime?
  webhookSubId  String? // Graph subscription ID, Phase B
  webhookExpiry DateTime? // Graph subscriptions expire every ~3 days
  lastSyncedAt  DateTime?
  isActive      Boolean        @default(true)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  messages      EmailMessage[]
}

model EmailMessage {
  id                String            @id @default(cuid())
  accountId         String
  account           EmailAccount      @relation(fields: [accountId], references: [id], onDelete: Cascade)
  projectId         String?
  project           Project?          @relation(fields: [projectId], references: [id], onDelete: SetNull)
  externalId        String            @unique // Graph message ID (cuid for mock)
  conversationId    String // groups messages into threads
  subject           String
  bodyPreview       String? // first 255 chars, plain text
  bodyHtml          String? // full body HTML
  fromEmail         String
  fromName          String?
  toEmails          String // JSON array: [{ email, name }]
  ccEmails          String? // JSON array: [{ email, name }]
  bccEmails         String? // JSON array: [{ email, name }]
  sentAt            DateTime
  receivedAt        DateTime
  tags              String            @default("[]") // JSON array e.g. ["Design","Schedule"]
  outlookLabel      String? // Outlook category that triggered match (Phase B)
  matchMethod       String? // EXACT_LABEL | FUZZY | MANUAL | SEEDED
  webUrl            String? // open in Outlook (Phase B)
  isRead            Boolean           @default(false)
  hasAttachments    Boolean           @default(false)
  attachments       EmailAttachment[]
  internetMessageId String?
  inReplyTo         String?
  parsedFields      String? // JSON: { esdDate, trackingNumber, leadTime }
  parseStatus       String? // PENDING | APPROVED | REJECTED | SKIPPED
  parsedById        String?
  parsedBy          User?             @relation("EmailParser", fields: [parsedById], references: [id])
  parsedAt          DateTime?
  createdAt         DateTime          @default(now())

  // ── Does this email count as real contact with a person? ──────────────────
  // Worked out once at write time by src/lib/email/classify.js, then stored, so
  // "when did we last really talk to them" is one indexed lookup instead of a
  // scan. Mike's rules: a mass email is 25 or more people on it; calendar
  // invites and replies do not count either.
  peopleCount      Int? // distinct people on it, sender included
  isMassEmail      Boolean            @default(false)
  isCalendarInvite Boolean            @default(false)
  isReplyMessage   Boolean            @default(false)
  isAutomated      Boolean            @default(false)
  countsAsContact  Boolean            @default(false) // true only when all four above are false
  contactLinks     EmailContactLink[]

  @@index([projectId])
  @@index([conversationId])
  @@index([outlookLabel])
  @@index([countsAsContact, sentAt])
}

// Which of our people were on an email, and in what capacity.
//
// The role is what tells the two Last Email fields apart: if the person SENT it,
// that is an email we received from them; if they were on the To/Cc/Bcc, that is
// an email we sent to them. One row per person per message.
model EmailContactLink {
  id        String       @id @default(cuid())
  messageId String
  message   EmailMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  contactId String
  contact   Contact      @relation(fields: [contactId], references: [id], onDelete: Cascade)
  role      String // FROM | TO | CC | BCC
  createdAt DateTime     @default(now())

  @@unique([messageId, contactId])
  @@index([contactId])
}

model EmailAttachment {
  id        String       @id @default(cuid())
  messageId String
  message   EmailMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  filename  String
  size      Int? // bytes — for display ("142 KB")
  mimeType  String? // used to choose file-type icon
  // fileUrl String?     // Phase B only — Microsoft Graph download URL
  createdAt DateTime     @default(now())

  @@index([messageId])
}

// ── Budget QC Checklist ───────────────────────────────────────────────────────

model BudgetQCChecklist {
  id           String         @id @default(cuid())
  projectId    String         @unique
  project      Project        @relation("ProjectBudgetQC", fields: [projectId], references: [id], onDelete: Cascade)
  assignedToId String?
  assignedTo   User?          @relation("QCAssignee", fields: [assignedToId], references: [id])
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  items        BudgetQCItem[]
}

model BudgetQCItem {
  id          String            @id @default(cuid())
  checklistId String
  checklist   BudgetQCChecklist @relation(fields: [checklistId], references: [id], onDelete: Cascade)
  itemKey     String
  checked     Boolean           @default(false)
  checkedById String?
  checkedBy   User?             @relation("QCItemChecker", fields: [checkedById], references: [id])
  checkedAt   DateTime?
  note        String? // acknowledgment note for auto-warn items
  createdAt   DateTime          @default(now())

  @@unique([checklistId, itemKey])
  @@index([checklistId])
}

// ── Pricing Intelligence ──────────────────────────────────────────────────────

model ProductPriceHistory {
  id            String   @id @default(cuid())
  manufacturer  String // normalized lowercase
  partNumber    String // normalized lowercase
  unitPrice     Float
  projectId     String
  project       Project  @relation("PriceHistory", fields: [projectId], references: [id], onDelete: Cascade)
  budgetVersion Int?
  recordedAt    DateTime @default(now())

  @@index([manufacturer, partNumber, recordedAt])
}

model ProductPriceCache {
  id            String   @id @default(cuid())
  manufacturer  String // normalized lowercase
  partNumber    String // normalized lowercase
  retailResults String // JSON: [{ source, price, link }] — max 5 results
  lowestRetail  Float
  lastChecked   DateTime @default(now())
  lastCheckedBy String? // userId — on manual refresh

  @@unique([manufacturer, partNumber])
}

// ── RFI Module ────────────────────────────────────────────────────────────────

model RFI {
  id                   String                @id @default(cuid())
  projectId            String
  project              Project               @relation(fields: [projectId], references: [id], onDelete: Cascade)
  rfiNumber            String
  subject              String
  receivedFrom         String // GC, EC, or 'ILC' if self-initiated
  rfiType              String // DIMENSION|CLASH_RELOCATION|CONTROLS|DRAWING_CLARIFICATION|SUBSTITUTION|MULTI_QUESTION|ILC_INITIATED|OTHER
  routingMode          String                @default("DIRECT") // DIRECT|THROUGH_ARCHITECT|REVIEW_ONLY
  status               String                @default("OPEN") // OPEN|IN_REVIEW|RESPONDED|CLOSED
  assignedToId         String?
  assignedTo           User?                 @relation("RFIAssignee", fields: [assignedToId], references: [id])
  procoreRfiId         String?               @unique
  procoreProjectId     String?
  dateReceived         DateTime              @default(now())
  dateDue              DateTime?
  shipFlag             Boolean               @default(false)
  shipFlagAcknowledged Boolean               @default(false)
  changeOrder          ChangeOrder?          @relation("COFromRFI") // backrelation — FK lives on ChangeOrder.rfiId
  // Pre-write draft fields
  draftText            String?
  draftStatus          String                @default("NONE") // NONE|GENERATING|READY|REVIEWED|SENT
  draftConfidence      String? // HIGH|MEDIUM|LOW|SUBSTITUTION
  draftGeneratedAt     DateTime?
  draftReviewedBy      String?
  draftReviewedAt      DateTime?
  closedAt             DateTime?
  closedBy             String?
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  activities           RFIActivity[]
  impactItems          RFIImpactItem[]
  drawingFlags         DrawingRevisionFlag[]

  @@index([projectId])
}

model RFIActivity {
  id          String          @id @default(cuid())
  rfiId       String
  rfi         RFI             @relation(fields: [rfiId], references: [id], onDelete: Cascade)
  direction   String // INBOUND|OUTBOUND
  authoredBy  String
  bodyText    String
  sentAt      DateTime        @default(now())
  createdAt   DateTime        @default(now())
  attachments RFIAttachment[]

  @@index([rfiId])
}

model RFIAttachment {
  id             String       @id @default(cuid())
  activityId     String
  activity       RFIActivity  @relation(fields: [activityId], references: [id], onDelete: Cascade)
  fileUrl        String
  fileName       String
  attachmentType String // ORIGINAL_RFI|ILC_MARKUP|ASI|GC_PHOTO|PRICING_DOC|OTHER
  drawingId      String?
  drawing        ProjectFile? @relation("RFIDrawing", fields: [drawingId], references: [id])
  createdAt      DateTime     @default(now())

  @@index([activityId])
}

model RFIImpactItem {
  id              String   @id @default(cuid())
  rfiId           String
  rfi             RFI      @relation(fields: [rfiId], references: [id], onDelete: Cascade)
  fixtureTypeFrom String?
  fixtureTypeTo   String?
  qtyDelta        Int      @default(0)
  itemNumber      Int?
  itemConfidence  String? // HIGH|MEDIUM|LOW
  itemDraftText   String?
  impactStatus    String   @default("PENDING") // PENDING|SCHEDULE_UPDATED|CO_GENERATED|SHIP_REVIEWED
  notes           String?
  createdAt       DateTime @default(now())

  @@index([rfiId])
}

model DrawingRevisionFlag {
  id         String      @id @default(cuid())
  drawingId  String
  drawing    ProjectFile @relation("DrawingRevisionFlags", fields: [drawingId], references: [id], onDelete: Cascade)
  rfiId      String
  rfi        RFI         @relation(fields: [rfiId], references: [id], onDelete: Cascade)
  flaggedAt  DateTime    @default(now())
  resolvedAt DateTime?
  resolvedBy String?

  @@index([drawingId])
  @@index([rfiId])
}

// ─────────────────────────────────────────────
// SALES BOT + AUTOMATION (Phase A)
// ─────────────────────────────────────────────

// Per-user bot settings
model BotConfig {
  id                  String   @id @default(cuid())
  userId              String   @unique
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  schedulingEnabled   Boolean  @default(false)
  followUpEnabled     Boolean  @default(false)
  reviewWindowMinutes Int      @default(30) // 0 = immediate, -1 = always manual
  proposalCount       Int      @default(3)
  confirmationMessage String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

// Per-user or company-default scheduling rules (userId null = company default)
model SchedulingRule {
  id                  String   @id @default(cuid())
  userId              String?
  user                User?    @relation("SchedulingRuleCreator", fields: [userId], references: [id], onDelete: Cascade)
  meetingType         String // COFFEE | SITE_VISIT | OFFICE_MEETING | CALL
  dealStage           String? // null = applies to all stages
  preferredDaysOfWeek String   @default("[\"MON\",\"TUE\",\"WED\",\"THU\",\"FRI\"]") // JSON array
  preferredStartTime  String   @default("09:00")
  preferredEndTime    String   @default("17:00")
  bufferBeforeMinutes Int      @default(15)
  bufferAfterMinutes  Int      @default(15)
  durationMinutes     Int      @default(60)
  locationType        String   @default("IN_OFFICE") // IN_OFFICE | CLIENT_SITE | COFFEE_SHOP | VIRTUAL
  homeBase            String?
  travelCity          String?
  travelBufferMinutes Int      @default(45)
  priority            Int      @default(0)
  isActive            Boolean  @default(true) // soft disable instead of delete
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@index([userId])
}

// Bot-generated draft waiting for review or auto-send
model BotDraft {
  id                   String    @id @default(cuid())
  userId               String
  user                 User      @relation("BotDraftOwner", fields: [userId], references: [id], onDelete: Cascade)
  projectId            String?
  project              Project?  @relation("ProjectBotDrafts", fields: [projectId], references: [id], onDelete: SetNull)
  emailThreadId        String? // loose ref to EmailThread.id (no FK yet — email pipeline Phase E)
  type                 String // SCHEDULING_REPLY | FOLLOW_UP
  status               String    @default("PENDING_REVIEW") // PENDING_REVIEW | SENT | MANUALLY_SENT | CANCELLED | CONFIRMED | AWAITING_CONFIRM
  toEmail              String
  toName               String?
  subject              String
  body                 String
  proposedSlots        String? // JSON: [{start, end, locationNote}]
  confirmedSlot        String? // JSON: {start, end}
  calendarEventId      String?
  reviewWindowMinutes  Int       @default(30)
  reviewExpiresAt      DateTime?
  sentAt               DateTime?
  cancelledAt          DateTime?
  editedByUserId       String?
  intentConfidence     Float?
  draftModel           String?
  classificationReason String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  @@index([userId])
  @@index([projectId])
  @@index([status])
}

// Automation rules: what triggers the bot and what it does
model BotRule {
  id             String    @id @default(cuid())
  name           String
  isActive       Boolean   @default(true)
  triggerType    String // INBOUND_EMAIL_INTENT | DEAL_STALE | MARKET_SIGNAL | DEAL_STAGE_CHANGE | MANUAL
  triggerConfig  String    @default("{}") // JSON — varies by triggerType
  actionType     String // DRAFT_SCHEDULING_REPLY | DRAFT_FOLLOW_UP_EMAIL | DRAFT_LINKEDIN_MESSAGE | NOTIFY_ONLY
  actionConfig   String    @default("{}") // JSON — templateId, reviewWindowMinutes, channel, etc.
  appliesTo      String    @default("ALL_SALES") // "ALL_SALES" | specific userId (Phase B+)
  executionOrder Int       @default(0)
  parentRuleId   String? // null = standalone; set = step in a sequence (Phase B+)
  parentRule     BotRule?  @relation("RuleChain", fields: [parentRuleId], references: [id])
  childRules     BotRule[] @relation("RuleChain")
  createdById    String
  createdBy      User      @relation("BotRuleCreator", fields: [createdById], references: [id])
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([triggerType])
  @@index([isActive])
}

// Learning ledger: one row per automation fire (baseline method behavior OR a
// user "if-then" rule). Captures whether the human accepted/edited/rejected the
// result, so rules can be reviewed and improved over time.
model AutomationLog {
  id          String   @id @default(cuid())
  triggerType String // NOTE_ACTION_CONFIRMED | NOTE_PUBLISHED | EMAIL_RECEIVED | CALENDAR_EVENT_CREATED
  eventRef    String? // id of the source (e.g. NoteAction.id)
  ruleId      String? // null = baseline (method-defined) behavior
  ruleName    String?
  actionType  String // DRAFT_EMAIL | DRAFT_TEXT | SCHEDULE_REMINDER | CREATE_TASK | ADD_TO_LIST | NOTIFY | BASELINE
  matched     Boolean  @default(true) // did the rule's conditions match?
  status      String   @default("FIRED") // FIRED | SKIPPED | ERROR
  detail      String?
  botDraftId  String? // the draft this produced, if any
  outcome     String   @default("PENDING") // PENDING | ACCEPTED | EDITED | REJECTED | NA
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([triggerType])
  @@index([ruleId])
  @@index([botDraftId])
  @@index([outcome])
}

// Email / LinkedIn / Meeting Agenda templates
model MessageTemplate {
  id          String   @id @default(cuid())
  name        String
  channel     String // EMAIL | LINKEDIN | MEETING_AGENDA
  scenario    String // new_intro | proposal_sent | follow_up | peer_review_sent | golf_invite | linkedin_connect | linkedin_move_to_email | meeting_recap | kick_off_agenda | custom
  dealStage   String? // null = all stages
  clientType  String? // null = all; DEVELOPER | ARCHITECT | GC | EC
  subject     String? // email only
  body        String
  direction   String? // AI instructions: rules, tone guidance, activity references, personalization hints
  variables   String   @default("[]") // JSON: ["clientName","projectName",...]
  isDefault   Boolean  @default(false)
  isActive    Boolean  @default(true)
  createdById String
  createdBy   User     @relation("TemplateCreator", fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([channel])
  @@index([scenario])
}

// Searchable knowledge base for bot context
model BotKnowledgeEntry {
  id          String   @id @default(cuid())
  category    String // GENERAL | DEVELOPERS | ARCHITECTS | ENGINEERS | CONTRACTORS
  keywords    String // comma-separated
  question    String
  answer      String
  isActive    Boolean  @default(true)
  source      String? // FAQ_IMPORT | MANUAL
  createdById String?
  createdBy   User?    @relation("KnowledgeCreator", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([category])
}

// A file dropped on the Bot Knowledge page — Word, Excel, PDF, or an image.
//
// A Q&A pair (BotKnowledgeEntry) is something somebody sat down and typed. This
// is the other half: the documents that already exist. The file itself is kept
// so it can be re-read later (a better extractor, or a human wanting the
// original), and `text` is the flattened version the bot actually searches.
//
// status is PENDING while the text is being pulled out, READY when it can be
// used, FAILED when the file could not be read — a scanned page with nothing
// legible on it, or a format we cannot open. A FAILED row is deliberately kept
// rather than deleted, so the file is not silently lost.
model BotKnowledgeDoc {
  id          String   @id @default(cuid())
  category    String   @default("GENERAL") // same free-text categories as BotKnowledgeEntry
  title       String // defaults to the filename, editable
  description String? // why this was added — typed by a human
  fileName    String
  fileType    String // pdf | word | excel | image | text
  mimeType    String?
  sizeBytes   Int
  storedPath  String // S3 key in prod, relative path in dev
  text        String? // extracted, what the bot searches
  charCount   Int      @default(0)
  pageCount   Int?
  status      String   @default("PENDING") // PENDING | READY | FAILED
  statusNote  String? // why it failed, in plain English
  isActive    Boolean  @default(true)
  createdById String?
  createdBy   User?    @relation("BotKnowledgeDocCreator", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // One composite rather than three singles. Every read here filters on the same
  // three columns in this order (see botKnowledge/retrieve.js), and a standalone
  // index on a two-value boolean earns nothing but write cost.
  @@index([isActive, status, category])
  @@index([createdById])
}

// Travel detection state — one row per day outside home base
model UserLocationState {
  id               String   @id @default(cuid())
  userId           String
  user             User     @relation("LocationStateOwner", fields: [userId], references: [id], onDelete: Cascade)
  date             String // "2026-06-10"
  city             String
  detectedFrom     String // calendar_location | title_extraction | client_match | manual
  calendarEventId  String?
  confidence       Float?
  overriddenByUser Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@unique([userId, date])
  @@index([userId])
}

// ─────────────────────────────────────────────
// RELATIONSHIP INTELLIGENCE
// ─────────────────────────────────────────────

// Default cadence per relationship tier — managed in Sales Automation → Scheduling Rules
model RelationshipCadenceRule {
  id          String   @id @default(cuid())
  tier        String // VIP_CLIENT | ACTIVE_DEAL | WARM_PROSPECT | PAST_CLIENT | COLD_PROSPECT
  label       String // "VIP Client", "Active Deal", etc.
  cadenceDays Int // days between required in-person touchpoints
  isActive    Boolean  @default(true)
  createdById String
  createdBy   User     @relation("CadenceRuleCreator", fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([tier])
}

// Rules for filtering out mass emails and recurring project meetings from relationship signal
model ActivityExclusionRule {
  id          String   @id @default(cuid())
  name        String // "Weekly OAC meetings", "Golf league blasts"
  ruleType    String // RECURRING_WEEKLY | RECURRING_BIWEEKLY | KEYWORD_SUBJECT | MIN_RECIPIENTS | SENDER_DOMAIN
  config      String   @default("{}") // JSON: { keywords: ["OAC"], minRecipients: 10, domain: "noreply.com" }
  isActive    Boolean  @default(true)
  createdById String
  createdBy   User     @relation("ExclusionRuleCreator", fields: [createdById], references: [id])
  createdAt   DateTime @default(now())

  @@index([ruleType])
}

// Ordered rules for classifying calendar events into activity types.
// Rules are checked highest-priority-first; first match wins.
// If no rule matches, Claude Haiku classifies the event.
model ActivityClassificationRule {
  id             String   @id @default(cuid())
  name           String
  conditionType  String // TITLE_CONTAINS | LOCATION_CONTAINS | LOCATION_TYPE | ATTENDEE_MAX | ATTENDEE_MIN | ORGANIZER_DOMAIN | DURATION_MIN | DURATION_MAX | BODY_CONTAINS
  conditionValue String // the value to test (e.g. "golf", "virtual", "15")
  resultType     String // COFFEE | MEAL | GOLF | HAPPY_HOUR | SITE_VISIT | TRAVEL | CALL | EVENT | OTHER | SKIP
  priority       Int      @default(0) // higher = checked first
  isActive       Boolean  @default(true)
  createdById    String
  createdBy      User     @relation("ClassificationRuleCreator", fields: [createdById], references: [id])
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([priority])
}

// ── Proposals Module ──────────────────────────────────────────────────────────

model Proposal {
  id         String            @id @default(cuid())
  projectId  String
  project    Project           @relation("ProjectProposals", fields: [projectId], references: [id], onDelete: Cascade)
  templateId String?
  template   ProposalTemplate? @relation("TemplateProposals", fields: [templateId], references: [id])

  type   String // FULL_DESIGN | DESIGN_ASSIST | PEER_REVIEW
  status String @default("DRAFT") // DRAFT | SENT | ACCEPTED | DECLINED | EXPIRED
  title  String

  // merge-field values for live tokens in docBody
  clientName      String?
  clientLegalName String?
  location        String?
  effectiveDate   DateTime?

  docBody String @default("") // HTML — seeded from template, then freely editable

  // fee
  calculatedFee  Float   @default(0) // snapshot updated on every line-item autosave
  overrideFee    Float?
  overrideActive Boolean @default(false)
  adderPct       Float   @default(10)
  milestoneSplit String? // JSON [{label,pct}] — FULL_DESIGN only

  // rate snapshot — copied from ProposalRate at creation; never changes after
  rateSnapshot String @default("{}") // JSON { SR_DESIGNER, DESIGNER, SALES, OUTSOURCE }

  sentAt     DateTime?
  acceptedAt DateTime?
  declinedAt DateTime?

  createdById String
  createdBy   User     @relation("UserProposals", fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  lineItems ProposalLineItem[] @relation("ProposalLineItems")
  sends     ProposalSend[]     @relation("ProposalSends")
}

model ProposalLineItem {
  id         String   @id @default(cuid())
  proposalId String
  proposal   Proposal @relation("ProposalLineItems", fields: [proposalId], references: [id], onDelete: Cascade)

  area           String
  task           String
  sortOrder      Int    @default(0)
  srHours        Float  @default(0)
  designerHours  Float  @default(0)
  salesHours     Float  @default(0)
  outsourceHours Float  @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ProposalTemplate {
  id          String  @id @default(cuid())
  name        String
  type        String // FULL_DESIGN | DESIGN_ASSIST | PEER_REVIEW
  projectType String? // MARKET_RATE | AFFORDABLE | STUDENT | SENIOR | null = any
  clientType  String? // DEVELOPER | GC | EC | null = any

  docBody         String  @default("")
  milestoneSplit  String? // JSON default for FULL_DESIGN
  defaultAdderPct Float   @default(10)
  exclusions      String? // rich text — scope notes / exclusions
  scopeMatrixRef  String? // optional file reference for RACI addendum

  isDefault Boolean @default(false)
  isActive  Boolean @default(true)

  createdById String
  createdBy   User     @relation("UserProposalTemplates", fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tasks     ProposalTemplateTask[] @relation("TemplateTasks")
  proposals Proposal[]             @relation("TemplateProposals")
}

model ProposalTemplateTask {
  id         String           @id @default(cuid())
  templateId String
  template   ProposalTemplate @relation("TemplateTasks", fields: [templateId], references: [id], onDelete: Cascade)

  area           String
  task           String
  sortOrder      Int    @default(0)
  srHours        Float  @default(0)
  designerHours  Float  @default(0)
  salesHours     Float  @default(0)
  outsourceHours Float  @default(0)
}

model ProposalRate {
  id          String   @id @default(cuid())
  role        String   @unique // SR_DESIGNER | DESIGNER | SALES | OUTSOURCE
  hourlyRate  Float
  updatedAt   DateTime @updatedAt
  updatedById String?
  updatedBy   User?    @relation("ProposalRateUpdater", fields: [updatedById], references: [id])
}

model ProposalSend {
  id         String   @id @default(cuid())
  proposalId String
  proposal   Proposal @relation("ProposalSends", fields: [proposalId], references: [id], onDelete: Cascade)

  sentToEmails    String // comma-separated
  note            String?
  docBodySnapshot String? // serialised docBody at time of send — immutable paper trail

  sentById String
  sentBy   User     @relation("UserProposalSends", fields: [sentById], references: [id])
  sentAt   DateTime @default(now())
}

model ProjectUnitType {
  id        String  @id @default(cuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  code      String // "2BR-K"
  label     String? // "2 Bed Corner K"
  qty       Int
  unitSf    Float? // per-unit rentable SF
  bedrooms  Int?
  bathrooms Int?
  balconies Int?
  sortOrder Int     @default(0)

  source     String @default("EXTRACTED") // EXTRACTED | MANUAL
  confidence Float?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model RoadmapPriority {
  id        String   @id @default(cuid())
  name      String
  status    String   @default("todo") // todo | wip | done
  sortOrder Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Public intake submissions from /start — held for ILC review before becoming real projects
model ConceptualSubmission {
  id               String   @id @default(cuid())
  submitterName    String
  submitterEmail   String
  submitterDomain  String // extracted from email; used to resolve clientId
  proposedName     String
  buildingType     String?
  // Where the job is (Mike, 2026-09-12: "We need location for data tracking").
  // Required on new requests; blank on anything older. Migration 0077.
  city             String?
  state            String? // two-letter code, e.g. TX
  zip              String? // 5 digits, or ZIP+4 stored as 12345-6789
  rawPayload       String? // JSON: full wizard answers from /start
  fileRefs         String   @default("[]") // JSON: uploaded drawing keys/refs
  duplicateMatchId String? // Project id if a likely duplicate was detected
  status           String   @default("PENDING") // PENDING | APPROVED | REJECTED
  reviewNote       String?
  clientId         String?
  reviewedById     String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  client         Client?                      @relation(fields: [clientId], references: [id], onDelete: SetNull)
  reviewedBy     User?                        @relation("SubmissionReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  duplicateMatch Project?                     @relation("SubmissionDuplicateMatch", fields: [duplicateMatchId], references: [id], onDelete: SetNull)
  answers        ConceptualSubmissionAnswer[]

  // "Looks like [Project X]" (Mike, 2026-09-12, migration 0078). Our guess,
  // made at submit time and never shown to the visitor. Kept apart from
  // duplicateMatchId on purpose: only a person links a request to a job.
  // "Not the same" stamps suggestionDismissedAt; nothing is deleted.
  suggestedProjectId    String?
  suggestedMatchReason  String? // plain English: "same name, same city"
  suggestionDismissedAt DateTime?
  suggestedProject      Project?  @relation("SubmissionSuggestedMatch", fields: [suggestedProjectId], references: [id], onDelete: SetNull)

  // The unfinished draft this request grew out of, when the visitor saved one
  // along the way (migration 0087).
  draft ConceptualDraft?

  // Page visits that ended in this request (migration 0090).
  visits ConceptualVisit[]
}

// One row per questionnaire answer on a public conceptual-budget submission.
// Rows (not a JSON blob) so the review queue and bots can filter on any
// answer ("everyone who asked for ceiling fans") — the queryable rule.
model ConceptualSubmissionAnswer {
  id           String   @id @default(cuid())
  submissionId String
  section      String // spreadsheet section, e.g. RESIDENTIAL UNITS
  questionKey  String // stable machine key, e.g. ceilingFans
  question     String // the question text as asked, frozen at submit time
  answer       String
  createdAt    DateTime @default(now())

  submission ConceptualSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  @@index([submissionId])
  @@index([questionKey])
}

// An unfinished public conceptual budget (Mike, 2026-09-15: "People need to be
// able to fill out a budget and come back to it somehow" / "Yes we should see
// it abandoned"). Migration 0087.
//
// The wizard saves a copy here once the visitor's name, email and project name
// check out, and keeps updating the same row as they go. Inputs only — never a
// price, never the pricing model. Staff see these on the intake queue as leads
// ("still working" / "abandoned"); submitting links the row to the real
// submission. Archive-only: "Put away" stamps archivedAt, nothing is deleted.
//
// The visitor's resume link carries a random token; only its SHA-256 lives
// here, so a copy of the database cannot be turned into working links. The link
// itself is built but stays hidden until Microsoft email is hooked up.
model ConceptualDraft {
  id             String    @id @default(cuid())
  tokenHash      String    @unique
  firstName      String
  lastName       String
  email          String
  emailDomain    String?
  company        String?
  projectName    String
  city           String?
  state          String?
  zip            String?
  haveDrawings   String? // yes | no
  stepId         String? // wizard step the visitor last had open
  completedSteps String    @default("") // comma-separated step ids
  hasClubhouse   String?
  buildingType   String? // engine key from the takeoff at save time
  unitCount      Int?
  grossSf        Int?
  drawingsJson   String? // merged drawing read (inputs only), capped — same exception rawPayload makes
  saveCount      Int       @default(1)
  lastSavedAt    DateTime  @default(now())
  linkEmailedAt  DateTime?
  submissionId   String?   @unique
  archivedAt     DateTime?
  archivedById   String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  submission ConceptualSubmission?  @relation(fields: [submissionId], references: [id], onDelete: SetNull)
  archivedBy User?                  @relation("DraftArchiver", fields: [archivedById], references: [id], onDelete: SetNull)
  fields     ConceptualDraftField[]
  visits     ConceptualVisit[]

  @@index([lastSavedAt])
  @@index([email])
}

// One row per typed figure, questionnaire answer or hand correction on an
// unfinished budget — rows, not a JSON blob, so staff and bots can ask
// "everyone who got as far as choosing ceiling fans".
model ConceptualDraftField {
  id      String @id @default(cuid())
  draftId String
  kind    String // answer | figure | correction
  key     String
  value   String

  draft ConceptualDraft @relation(fields: [draftId], references: [id], onDelete: Cascade)

  @@unique([draftId, kind, key])
  @@index([kind, key])
}

// One row per visit to the public /conceptual_budget page (Mike, 2026-09-16:
// "build the tracking feature, it would be hugely helpful"). Migration 0090.
//
// Answers "how many people opened the page, where did they come from, how far
// did they get, and which of them became a lead". Rows and columns, so the
// Sales dashboard and the bots can count them.
//
// No personal data: no IP address, no browser string, no full web address.
// `visitorKey` is a one-way SHA-256 of the two, there only so a second visit
// from the same place reads as a returning visitor. A visit gets a name only
// when that person saves a draft or submits — through draftId / submissionId.
// Archive-only, like everything else.
model ConceptualVisit {
  id           String    @id @default(cuid())
  visitorKey   String
  referrerHost String? // "linkedin.com" — the site only, never the full address
  utmSource    String?
  utmMedium    String?
  utmCampaign  String?
  deviceKind   String    @default("desktop") // desktop | tablet | mobile
  stepReached  String    @default("about") // furthest wizard step id opened
  stepIndex    Int       @default(0) // its position, so funnels sort and count
  pings        Int       @default(1)
  visitedAt    DateTime  @default(now())
  lastSeenAt   DateTime  @default(now())
  draftId      String?
  submissionId String?
  archivedAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  draft      ConceptualDraft?      @relation(fields: [draftId], references: [id], onDelete: SetNull)
  submission ConceptualSubmission? @relation(fields: [submissionId], references: [id], onDelete: SetNull)

  @@index([visitedAt])
  @@index([visitorKey])
  @@index([draftId])
  @@index([submissionId])
}

// Governed AI Layer, Slice 4b — one row per reviewable AI run: what the model
// said, what the auto-checks found, and what a person decided. The accuracy
// record that agentTrust.js computes tiers from.
//
// Purely additive. Column names/types are the contract already enforced by
// src/lib/agent/reviewStore.js (buildRow) — the store detects this model and
// switches itself from the dev file stand-in to these rows automatically.
//
// projectId/userId are indexed strings, deliberately NOT hard relations: the
// accuracy record must outlive the things it measured (a cascading delete of a
// project must never erase verdict history the trust tiers are computed from).
model AgentRun {
  id            String  @id @default(cuid())
  taskType      String // "extract.unitMatrix", ...
  feature       String? // "unit-matrix", ...
  model         String?
  promptVersion String? // trust history is keyed to this
  via           String  @default("app")

  projectId    String?
  clientId     String?
  userId       String?
  sourceFileId String?

  inputTokens  Int?
  outputTokens Int?
  cachedTokens Int?
  costUsd      Float?
  latencyMs    Int?

  inputSummary String? // hash + descriptor ONLY — never the document
  outputJson   String? // JSON: the model's proposal, stored for review
  confidence   Float?
  citations    String? // JSON

  reviewable    Boolean  @default(true)
  autoChecks    String? // JSON: per-check results from autoChecks.js
  autoCheckPass Boolean? // null = all checks skipped, never coerced to true

  // Write-once verdict — a signature. Enforced in reviewStore.recordVerdict
  // via updateMany({ where: { id, verdict: null } }).
  verdict     String? // accepted | corrected | rejected
  verdictById String?
  verdictAt   DateTime?
  correction  String? // what the reviewer changed, human-readable
  note        String?

  status       String  @default("PENDING") // PENDING | AUTO_PASSED | AWAITING_REVIEW | CLOSED | ERROR
  errorMessage String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([taskType, promptVersion])
  @@index([status])
  @@index([projectId])
}

// ── MCP audit log (2026-09-14, migration 0081) ──────────────────────────────
// One row per MCP tool call: who asked, which tool, with what question, how
// many rows came back. Row counts, never the rows — a record of access, not a
// second copy of the data. src/lib/mcp/audit.js writes here; without this
// table the production MCP server refuses every request (503) rather than
// serve unlogged reads.
model McpQueryLog {
  id          String   @id @default(cuid())
  at          DateTime @default(now())
  callerKind  String? // user | token
  callerId    String?
  callerEmail String?
  callerRole  String?
  audience    String?
  tool        String // get_client_360, ...
  model       String?
  params      String? // JSON: the question asked (≤ 4000 chars), not the answer
  rowCount    Int?
  durationMs  Int?
  status      String   @default("ok") // ok | error | denied
  error       String? // ≤ 500 chars

  @@index([at])
  @@index([tool])
  @@index([callerEmail])
}

// ── Pricing calibration (learning loop, 2026-09-04) ─────────────────────────
// One row per budget line per capture: what the engine modeled (amount, the
// quantity it multiplied, the rate it used) next to what Mike/reality said
// (actualAmount). The Pre-Con dashboard's calibration widgets read these to
// show rate drift per line and propose a corrected rate. Structured rows, no
// JSON blobs — every column is a filter the dashboard and bots can use.
model CalibrationSample {
  id              String   @id @default(cuid())
  projectId       String
  project         Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  source          String // engine | manual | actual | bidmatrix | backfill
  lineKey         String // units | corridors | boh | interior | garage | exterior.* | emergency | exitSigns | controls | total
  quantity        Float? // the driver the engine multiplied (SF, units, fixtures, landings…)
  quantityUnit    String? // sf | units | fixtures | landings | stalls
  modelAmount     Float // what the engine produced for this line
  actualAmount    Float? // hand-built / bid-matrix / invoiced figure, when known
  rateUsed        Float? // pricing-sheet rate the line was built from
  impliedRate     Float? // actualAmount ÷ quantity — the rate reality implies
  buildingType    String?
  siteDesignLevel String? // conventional | solar
  note            String?
  capturedAt      DateTime @default(now())

  @@index([projectId])
  @@index([lineKey])
  @@index([capturedAt])
}

// ── CRM tags (Mike 2026-09-06) ───────────────────────────────────────────────
// Free-form client tags. Structured rows, not a JSON blob, so renaming a tag
// renames it everywhere it is used and deleting one removes every link.
model ClientTag {
  id        String          @id @default(cuid())
  name      String          @unique
  createdAt DateTime        @default(now())
  links     ClientTagLink[]
}

model ClientTagLink {
  id        String    @id @default(cuid())
  clientId  String
  client    Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  tagId     String
  tag       ClientTag @relation(fields: [tagId], references: [id], onDelete: Cascade)
  createdAt DateTime  @default(now())

  @@unique([clientId, tagId])
  @@index([tagId])
}

// ── Alert feedback (migration 0093) ───────────────────────────────────────────
// Two buttons on every notification: Useful and Don't need. One row per click.
// Structured rows, never a blob — "which alerts are noise" has to be a question
// the admin report can answer by counting, not by reading text.
model AlertFeedback {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  alertId   String? // the UserAlert clicked on; null once that alert is gone
  alertType String // UserAlert.type — a NOTIFICATION_TYPES key where one fits
  verdict   String // USEFUL | NOT_USEFUL
  createdAt DateTime @default(now())

  @@index([alertType, verdict])
  @@index([userId, alertType])
}

// Someone said "Don't need" three times on the same kind of alert, was asked,
// and said stop. One row per person per kind. Removing the row turns it back on.
model AlertMute {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  alertType String
  mutedAt   DateTime @default(now())

  @@unique([userId, alertType])
}

// ── Per-person MCP keys (migration 0094) ──────────────────────────────────────
// Before this table there was one shared MCP_API_TOKEN, so every line in the
// audit log said "mcp-service" and the question "who asked for that client's
// numbers?" had no answer. One row per issued key; the key belongs to a person,
// and a key inherits that person's role — so a key issued to a CLIENT_VIEWER
// sees exactly the client-redacted view, not the ILC one.
//
// Only the SHA-256 of the key is stored. Nothing anywhere can print the key back
// after the moment it is created; a lost key is replaced, never recovered.
// Keys are revoked, never deleted — a deleted key is an audit trail that stops
// explaining itself.
model McpApiKey {
  id          String    @id @default(cuid())
  name        String // what it is for: "Mike laptop agent", "nightly rollup"
  prefix      String // the visible first characters, for telling keys apart
  tokenHash   String    @unique // sha-256 hex of the whole presented key
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdById String?
  lastUsedAt  DateTime?
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())

  @@index([userId])
  @@index([revokedAt])
}

// ─────────────────────────────────────────────────────────────────────────────
// UNIT SELECTIONS (migration 0095)
//
// The five decorative fixtures a developer, architect and interior designer
// argue about on every job: the kitchen island pendant (p1), the bath vanity
// (v1), the balcony sconce (ew1), the unit-entry corridor sconce (w1) and the
// ceiling fan (f1). Today that argument happens over email and lands in nobody's
// records. This turns it into a short survey with one row per answer, so the
// outcome is queryable — "what did Greystar pick for P1 last year" is a query,
// not a search of somebody's inbox.
//
// Two rules the shape of these tables exists to enforce:
//   1. Nothing is averaged. If three people disagree the survey SAYS they
//      disagree (UnitSelectionResult.agreement = DIVERGENT) and a person picks.
//   2. dnPrice lives on DecorativeOptionFinish and is INTERNAL ONLY. The share
//      routes select fields explicitly and never name it. An outside respondent
//      sees a price band, never a number.
// ─────────────────────────────────────────────────────────────────────────────

// One decorative fixture body in the pool ILC offers. Finish-independent — the
// same body in four finishes is one row here and four DecorativeOptionFinish
// rows. Archive-only: isActive false retires it, nothing is deleted.
model DecorativeOption {
  id           String   @id @default(cuid())
  category     String // p1 | v1 | ew1 | w1 | f1
  name         String
  bodyKey      String // stable slug for the body, so a finish change is not a new fixture
  shape        String   @default("") // round | linear | drum | lantern | globe | bar | mirror
  style        String   @default("") // modern | transitional | traditional | industrial | farmhouse
  dimLabel     String   @default("") // "7in dia x 12in H" — displayed, never parsed
  projectionIn Float? // wall projection in inches (w1, ew1). The 6'-8" rule reads this.
  bladeSpanIn  Float? // blade span in inches (f1)
  wetRated     Boolean  @default(false)
  dampRated    Boolean  @default(false)
  imageUrl     String?
  sortOrder    Int      @default(0)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  finishes DecorativeOptionFinish[]
  choices  UnitSelectionChoice[]
  results  UnitSelectionResult[]

  @@index([category, isActive])
}

// One body in one finish: the thing that actually has a catalog number and a
// price. dnPrice is the buy price and NEVER leaves the building — no share
// route, no PDF, no client portal.
model DecorativeOptionFinish {
  id            String           @id @default(cuid())
  optionId      String
  option        DecorativeOption @relation(fields: [optionId], references: [id], onDelete: Cascade)
  finishKey     String // matte_black | brushed_nickel | aged_brass | bronze | white | chrome
  catalogNumber String?
  manufacturer  String?
  productId     String? // provenance into the product library, same convention as ClientStandardFixture.optionId
  dnPrice       Float? // INTERNAL ONLY — buy price. Never selected by a share route.
  cnPrice       Float? // sell price. What the budget target is compared against.
  leadTimeWks   Int?
  imageUrl      String?
  isDefault     Boolean          @default(false)
  isActive      Boolean          @default(true)
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  @@unique([optionId, finishKey])
}

// One run of the survey on one project. factsSnapshot freezes what the engine
// resolved the moment the survey opened, so a later questionnaire edit cannot
// silently change what people were shown.
model UnitSelectionSurvey {
  id            String    @id @default(cuid())
  projectId     String
  project       Project   @relation("ProjectUnitSelections", fields: [projectId], references: [id], onDelete: Cascade)
  version       Int       @default(1)
  status        String    @default("DRAFT") // DRAFT | SENT | CLOSED
  factsSnapshot String    @default("{}") // JSON: the resolveFacts() result, frozen
  styleSeed     String? // the style the survey opened on, if one was suggested
  createdById   String?
  closedAt      DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  responses UnitSelectionResponse[]
  results   UnitSelectionResult[]

  @@unique([projectId, version])
}

// One person answering. shareToken follows FixtureScheduleShare: a cuid on the
// row, so a link is issued without a second table.
model UnitSelectionResponse {
  id             String              @id @default(cuid())
  surveyId       String
  survey         UnitSelectionSurvey @relation(fields: [surveyId], references: [id], onDelete: Cascade)
  respondentName String
  respondentRole String // DEVELOPER | ARCHITECT | INTERIOR_DESIGNER | ILC
  contactId      String? // the Contact row this is, when we know it
  userId         String? // the staff member answering for themselves; set automatically, never typed
  shareToken     String              @unique @default(cuid())
  styleChoice    String?
  finishOverride String? // set = the derived finish is ignored for this respondent
  fanHoldWhite   Boolean             @default(true) // fans stay white regardless of the finish everything else landed on
  notes          String              @default("{}") // JSON: {category: "free text"}
  startedAt      DateTime?
  submittedAt    DateTime?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  choices UnitSelectionChoice[]

  @@index([surveyId])
  @@index([surveyId, userId])
}

// One person's verdict on one option. A REJECT is a first-class answer, not the
// absence of a pick — it is what makes one dissenting voice visible.
model UnitSelectionChoice {
  id         String                @id @default(cuid())
  responseId String
  response   UnitSelectionResponse @relation(fields: [responseId], references: [id], onDelete: Cascade)
  category   String
  optionId   String
  option     DecorativeOption      @relation(fields: [optionId], references: [id])
  kind       String // PICK | REJECT
  finishKey  String?
  createdAt  DateTime              @default(now())

  @@unique([responseId, category, optionId])
}

// What the survey concluded for one category. Never an average — agreement says
// plainly whether everybody agreed, and divergence keeps who said what.
model UnitSelectionResult {
  id           String              @id @default(cuid())
  surveyId     String
  survey       UnitSelectionSurvey @relation(fields: [surveyId], references: [id], onDelete: Cascade)
  category     String
  optionId     String
  option       DecorativeOption    @relation(fields: [optionId], references: [id])
  finishKey    String
  agreement    String // UNANIMOUS | DIVERGENT | SINGLE
  divergence   String              @default("[]") // JSON: [{respondentName, role, optionId, kind}]
  resolvedById String?
  resolvedAt   DateTime?
  note         String?
  pushedAt     DateTime?
  pushedItemId String? // the FixtureScheduleItem this became
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  @@unique([surveyId, category])
}
