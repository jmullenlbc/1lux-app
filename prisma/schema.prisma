model ProjectExternalContact {
  id                       String      @id @default(cuid())
  project_id               String
  project                  Project     @relation(fields: [project_id], references: [id], onDelete: Cascade)
  portalUserId             String?
  portalUser               PortalUser? @relation(fields: [portalUserId], references: [id], onDelete: SetNull)
  name                     String
  email                    String
  role                     String
  canViewShipSchedule      Boolean     @default(false)
  canViewSubmittals        Boolean     @default(false)
  canViewMeetings          Boolean     @default(false)
  canViewContracts         Boolean     @default(false)
  canViewConstructionSched Boolean     @default(false)
  canViewChangeOrders      Boolean     @default(false)
  canViewBudgets           Boolean     @default(false)
  inviteToken              String?     @unique
  inviteTokenExpiresAt     DateTime?
  invitedAt                DateTime?
  acceptedAt               DateTime?
  createdAt                DateTime    @default(now())
  updatedAt                DateTime    @updatedAt

  @@unique([project_id, email])
