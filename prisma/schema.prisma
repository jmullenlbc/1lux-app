// A concept = a chosen spec for a standards answer (one, or N for a pool), with a
// product/spec image. Queryable + bot-actionable: resolves to a FixtureType/SKU
// and carries the image the bot/human references. (Standards "elicitation engine"
// concept layer — built on top of the existing answer model.)
model StandardsAnswerConcept {
  id          String                @id @default(cuid())
  answerId    String
  answer      ClientStandardsAnswer @relation(fields: [answerId], references: [id], onDelete: Cascade)
  clientId    String // denormalized for direct "concepts for client X" queries
  questionKey String // denormalized for "concepts for question Y"
  description String?
  imageKey    String? // qcStorage object key (resolved to a URL on read)
  typeCode    String? // bare ref to FixtureType.code
  resolvedSku String?
  sortOrder   Int                   @default(0)
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt

  @@index([clientId, questionKey])
  @@index([answerId])
}

// ═══ PRODUCT OPTIONS (the "Alternate Options" approval funnel — matches LAC) ═══
// A pool of product options per category. Approve/reject; approved options feed the
// standard fixture schedule. Columns mirror LAC: Concept Link · Notes · Price
// Estimate · Price Target · Approved, grouped by Category.
model ClientProductOption {
  id            String   @id @default(cuid())
  clientId      String
  client        Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  category      String   @default("") // 'Vanity' | 'Kitchen Pendants' | 'Ceiling Fans' ...
  name          String   @default("") // 'Cone glass'  (the "concept link" label)
  imageKey      String? // uploaded picture
  productUrl    String? // concept link
  notes         String?
  priceEstimate Float?
  priceTarget   Float?
  status        String   @default("PENDING") // PENDING | APPROVED | REJECTED
  sortOrder     Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([clientId, category])
}

// ═══ CLIENT STANDARD FIXTURE SCHEDULE ═══
// The client's standard fixture schedule — assembled AFTER spec approvals. One row
// per fixture type, carrying the approved option's picture + target price. The exact
// SKU (manufacturer/catalogNumber) is picked per project by a person, not locked here.
