generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id                         String                       @id @default(cuid())
  email                      String                       @unique
  name                       String?
  passwordHash               String?
  role                       String                       @default("USER")
  // Retired 2026-09-12 (migration 0079): replaced by `departments` below. Kept,
  // never dropped; the app no longer reads or writes them.
  division                   String? // SALES | OPERATIONS | FINANCE | PRECONSTRUCTION | CONSTRUCTION
  deptRoles                  String                       @default("[]") // JSON: ["Operations","Design",...]
  departments                UserDepartment[]
  // Roles: SUPER_ADMIN | COMPANY_ADMIN | USER | CLIENT_VIEWER
  // Legacy roles still supported: ILC_ADMIN (=SUPER_ADMIN), ADMIN (=COMPANY_ADMIN)
  permissions                String                       @default("{}") // JSON: { projects, clients, preCon, manufacturers, admin, knowledgeBase }
  mustChangePassword         Boolean                      @default(false)
  isActive                   Boolean                      @default(true)
  inviteToken                String?                      @unique
  inviteExpiry               DateTime?
  dashboardConfig            String? // JSON: { version, widgets: [{id, order, size?}] }
  // Which internal alerts this person wants (Profile screen). The screen saved
  // here for months while the column did not exist, so every choice was lost.
  // Added by migration 0084.
  notificationPrefs          String? // JSON: { [notificationType]: boolean }
  createdAt                  DateTime                     @default(now())
  updatedAt                  DateTime                     @updatedAt
  invitedById                String?
  projects                   Project[]
  clients                    Client[]
  assignedProjects           ProjectAssignee[]
  uploadedFiles              ProjectFile[]
  projectAccess              ProjectAccess[]
  alertFeedback              AlertFeedback[]
  alertMutes                 AlertMute[]
  standardsCreated           DesignStandard[]             @relation("KBCreator")
  standardsUpdated           DesignStandard[]             @relation("KBUpdater")
  salesOwnedProjects         Project[]                    @relation("ProjectSalesOwner")
  notesCreated               Note[]                       @relation("NoteCreator")
  publishedSchedules         FixtureSchedule[]            @relation("SchedulePublisher")
  pushedBidMatrices          DesignBidMatrix[]            @relation("BidPusher")
  tasksCreated               Task[]                       @relation("TaskCreator")
  tasksAssigned              Task[]                       @relation("TaskAssignee")
  dashboards                 Dashboard[]                  @relation("DashboardCreator")
  ownedDashboards            Dashboard[]                  @relation("DashboardOwner")
  dashboardShares            DashboardShare[]             @relation("DashboardSharedWith")
  hiddenDashboardWidgets     DashboardHiddenWidget[]      @relation("DashboardWidgetHider")
  archivedClients            Client[]                     @relation("ClientArchiver")
  archivedProjects           Project[]                    @relation("ProjectArchiver")
  archivedContacts           Contact[]                    @relation("ContactArchiver")
  archivedNotes              Note[]                       @relation("NoteArchiver")
  archivedProjectFiles       ProjectFile[]                @relation("ProjectFileArchiver")
  archivedDrawingSets        DrawingSubmission[]          @relation("DrawingSubmissionArchiver")
  archivedProducts           ManufacturerProduct[]        @relation("ProductArchiver")
  archivedBidMatrices        DesignBidMatrix[]            @relation("BidMatrixArchiver")
  standardsAnswers           ClientStandardsAnswer[]      @relation("AnsweredByUser")
  standardsOverrides         ProjectStandardsOverride[]   @relation("OverrideActivator")
  confirmedFixtures          PlacedFixture[]              @relation("FixtureConfirmer")
  drawingUploads             DrawingSubmission[]          @relation("DrawingUploader")
  fixtureShares              FixtureScheduleShare[]       @relation("FixtureShareCreator")
  changeOrdersCreated        ChangeOrder[]                @relation("COCreator")
  changeOrderSends           ChangeOrderSend[]            @relation("COSender")
  changeOrderShares          ChangeOrderShare[]           @relation("COShareCreator")
  parsedEmails               EmailMessage[]               @relation("EmailParser")
  qcAssignments              BudgetQCChecklist[]          @relation("QCAssignee")
  qcItemsChecked             BudgetQCItem[]               @relation("QCItemChecker")
  assignedRFIs               RFI[]                        @relation("RFIAssignee")
  warehouseReleases          WarehouseRelease[]           @relation("WarehouseReleaser")
  statusChanges              ProjectStatusEvent[]         @relation("ProjectStatusEventChangedBy")
  verificationActions        VerificationAction[]         @relation("VerificationActor")
  approvedReleases           WarehouseRelease[]           @relation("ReleaseApprover")
  deliveryEventsCreated      ManufacturerDeliveryEvent[]  @relation("DeliveryEventCreator")
  shipSchedulePushes         ShipSchedulePush[]           @relation("ShipPusher")
  ownedClients               Client[]                     @relation("ClientOwner")
  alerts                     UserAlert[]
  // Sales Bot
  homeBaseCity               String?
  homeBaseAddress            String?
  // Email tone profile — extracted from sent email history (mbox upload)
  toneProfile                String? // JSON: { summary, phrases[], openers[], closers[], formality, examples[] }
  toneProfileBuiltAt         DateTime? // when the profile was last generated
  toneProfileSource          String? // "gmail_mbox" | "outlook_mbox" | "manual"
  botConfig                  BotConfig?
  botDrafts                  BotDraft[]                   @relation("BotDraftOwner")
  schedulingRules            SchedulingRule[]             @relation("SchedulingRuleCreator")
  messageTemplates           MessageTemplate[]            @relation("TemplateCreator")
  botKnowledgeEntries        BotKnowledgeEntry[]          @relation("KnowledgeCreator")
  botKnowledgeDocs           BotKnowledgeDoc[]            @relation("BotKnowledgeDocCreator")
  userLocationStates         UserLocationState[]          @relation("LocationStateOwner")
  botRulesCreated            BotRule[]                    @relation("BotRuleCreator")
  submittalResponses         SubmittalResponse[]          @relation("SubmittalResponseCreator")
  cadenceRulesCreated        RelationshipCadenceRule[]    @relation("CadenceRuleCreator")
  exclusionRulesCreated      ActivityExclusionRule[]      @relation("ExclusionRuleCreator")
  classificationRulesCreated ActivityClassificationRule[] @relation("ClassificationRuleCreator")
  proposalsCreated           Proposal[]                   @relation("UserProposals")
  proposalSends              ProposalSend[]               @relation("UserProposalSends")
  proposalTemplatesCreated   ProposalTemplate[]           @relation("UserProposalTemplates")
  proposalRatesUpdated       ProposalRate[]               @relation("ProposalRateUpdater")
  bugReportsCreated          BugReport[]                  @relation("BugReportReporter")
  bugReportsAssigned         BugReport[]                  @relation("BugReportAssignee")
  archivedBugReports         BugReport[]                  @relation("BugReportArchiver")
  preconManagedProjects      Project[]                    @relation("ProjectPreconManager")
  reviewedSubmissions        ConceptualSubmission[]       @relation("SubmissionReviewer")
  accessEvents               UserAccessEvent[]            @relation("UserAccessEventSubject")
  accessChangesMade          UserAccessEvent[]            @relation("UserAccessEventActor")
  archivedDrafts             ConceptualDraft[]            @relation("DraftArchiver")
  mcpApiKeys                 McpApiKey[]
}

model UserAlert {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String
  title     String
  message   String
  link      String?
  isRead    Boolean  @default(false)
  dedupeKey String?  @unique
  createdAt DateTime @default(now())
}

model BugReport {
  id            String    @id @default(cuid())
  title         String
  description   String    @default("")
  status        String    @default("NEW") // NEW | IN_PROGRESS | FIXED
  severity      String    @default("MAJOR") // BLOCKER | MAJOR | MINOR | COSMETIC
  module        String?
  pageUrl       String?
  projectId     String?
  expectedText  String?
  actualText    String?
  screenshotKey String?
  recordingKey  String?
  consoleJson   String    @default("[]") // JSON string: [{level,msg,ts}]
  networkJson   String    @default("[]") // JSON string: [{method,url,status,ts}]
  pageStateJson String?
  browserInfo   String?
  viewport      String?
  // Null for a public beta visitor, who has no account (migration 0078): their
  // typed name and email ride in reporterName/reporterEmail instead.
  reporterId    String?
  reporter      User?     @relation("BugReportReporter", fields: [reporterId], references: [id], onDelete: NoAction)
  reporterName  String?
  reporterEmail String?
  source        String    @default("STAFF") // STAFF | PUBLIC
  assigneeId    String?
  assignee      User?     @relation("BugReportAssignee", fields: [assigneeId], references: [id])
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  // Archived, never deleted (migration 0079). The S3 screenshot stays too.
  archivedAt    DateTime?
  archivedById  String?
  archivedBy    User?     @relation("BugReportArchiver", fields: [archivedById], references: [id], onDelete: SetNull)

  // Declared to match what migration 0027 already built, so the schema and the
  // database agree. No database change.
  @@index([status])
  @@index([reporterId])
  @@index([assigneeId])
}

// One row per person per department (migration 0079). Keys and labels live in
// src/lib/departments.js.
model UserDepartment {
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  department String // SALES_MARKETING | OPERATIONS | PRECONSTRUCTION | CONSTRUCTION | DESIGN | FINANCE (PROJECT_MANAGEMENT folded into CONSTRUCTION, migration 0085)
  createdAt  DateTime @default(now())

  @@id([userId, department])
  @@index([department])
}

model Task {
  id          String           @id @default(cuid())
  title       String
  description String?
  status      String           @default("TODO") // TODO | IN_PROGRESS | IN_REVIEW | DONE
  priority    String           @default("MEDIUM") // LOW | MEDIUM | HIGH | URGENT
  assigneeId  String?
  createdById String
  dueDate     DateTime?
  tags        String           @default("[]") // JSON string array of menu tag ids
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  assignee    User?            @relation("TaskAssignee", fields: [assigneeId], references: [id])
  createdBy   User             @relation("TaskCreator", fields: [createdById], references: [id])
  attachments TaskAttachment[]
}

model TaskAttachment {
  id           String   @id @default(cuid())
  taskId       String
  task         Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  originalName String
  storedPath   String
  mimeType     String?
  size         Int
  createdAt    DateTime @default(now())
}

model KbCategory {
  id        String   @id @default(cuid())
  key       String   @unique
  label     String
  desc      String   @default("")
  color     String   @default("slate")
  icon      String   @default("📁")
  position  Int      @default(0)
  isBuiltIn Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model DesignStandard {
  id             String   @id @default(cuid())
  category       String
  title          String
  content        String
  severity       String   @default("REQUIRED") // REQUIRED | RECOMMENDED | NOTE
  tags           String   @default("[]")
  sourceUrl      String?
  isActive       Boolean  @default(true)
  superAdminOnly Boolean  @default(false)
  createdById    String
  updatedById    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  createdBy      User     @relation("KBCreator", fields: [createdById], references: [id])
  updatedBy      User?    @relation("KBUpdater", fields: [updatedById], references: [id])
}

model Client {
  id           String    @id @default(cuid())
  clientNumber Int?      @unique
  // Archived, never deleted (Mike, 2026-09-11: "archive only for everything").
  // Set = hidden from every list, picker and count; the row and everything
  // hanging off it is kept, and Restore on the Archive page clears it.
  archivedAt   DateTime?
  archivedById String?
  archivedBy   User?     @relation("ClientArchiver", fields: [archivedById], references: [id], onDelete: SetNull)
  name         String
  type         String    @default("developer")
  locationType String    @default("standalone")

  email   String?
  phone   String?
  website String?
  address String?
  city    String?
  state   String?

  linkedIn            String?
  primaryContact      String?
  primaryContactTitle String?
  primaryContactEmail String?
  primaryContactPhone String?

  notes String?

  tier            String?
  markets         String  @default("[]")
  geographies     String  @default("[]")
  projectTypes    String  @default("[]")
  projectsPerYear Int?
  pipelinePerUnit Float? // ILC $/unit used for the pipeline value rollup
  developerType   String? // legacy single value — kept in sync with developerTypes[0]
  developerTypes  String  @default("[]") // JSON array: merchant | longTermHold (Mike 2026-09-06: multi-select)
  rating          String? // Client Rating — free-text placeholder until the equation is defined
  orgTypes        String  @default("[]")
  emailDomains    String  @default("[]")

  ownerId              String?
  owner                User?                   @relation("ClientOwner", fields: [ownerId], references: [id])
  createdAt            DateTime                @default(now())
  updatedAt            DateTime                @updatedAt
  createdById          String
  createdBy            User                    @relation(fields: [createdById], references: [id])
  projects             Project[]
  contacts             Contact[]
  kbSections           ClientKBSection[]
  standardsAnswers     ClientStandardsAnswer[]
  standardFixtures     ClientStandardFixture[]
  productOptions       ClientProductOption[]
  noteLinks            NoteClient[]
  standardsShare       ClientStandardsShare?
  playbook             ClientPlaybook?
  paymentTerms         String? // NET30 | NET45 | NET60 | OTHER — shown on Overview (moved off Playbook)
  playbookAssignments  PlaybookAssignment[]    @relation("ClientPlaybookAssignments")
  playbookDistribution PlaybookDistribution[]  @relation("ClientPlaybookDistribution")
  playbookNotes        PlaybookNote[]          @relation("ClientPlaybookNotes")
  pipelineUploads      PipelineUpload[]
  pipelineProjects     PipelineProject[]
  signals              MarketSignal[]
  aliases              ClientAlias[]
  cadenceDays          Int? // company-level cadence override; null = use individual tier defaults
  intakeSubmissions    ConceptualSubmission[]
  tagLinks             ClientTagLink[]

  // Projects where this company holds a seat on the team but is not the client
  // we are selling to. `projects` above is still "their own jobs".
  teamDeveloperOn            Project[] @relation("ProjectDeveloper")
  teamGeneralContractorOn    Project[] @relation("ProjectGeneralContractor")
  teamElectricalContractorOn Project[] @relation("ProjectElectricalContractor")
  teamInteriorDesignerOn     Project[] @relation("ProjectInteriorDesigner")
  teamElectricalEngineerOn   Project[] @relation("ProjectElectricalEngineer")
  teamArchitectOn            Project[] @relation("ProjectArchitect")
}

model ClientPlaybook {
  id       String @id @default(cuid())
  clientId String @unique
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  // Section 1 — Account Profile (relationships normalized → PlaybookRelationship)
  projectTypes    String? // JSON array: ['BTR','GARDEN','PODIUM','HIGHRISE','LIHTC']
  projectsPerYear Int?
  primaryMarkets  String? // JSON array of US state codes

  // Section 2 — Introductions & Onboarding
  introOwnerContactId String? // who introduces ILC (Contact id)
  introOwnerNote      String? // fallback / context when not a CRM contact
  onVendorList        Boolean @default(false)
  vendorListNote      String?
  pipelineFeed        String? // how ILC learns of new deals
  introNotes          String?

  // Section 3 — Communication posture (recipients normalized → PlaybookDistribution)
  commsPosture String? // e.g. "CC more, not less"

  // Section 5 — Process & Timeframes
  engagementTiming       String? // SD|DD|CD|BID|VARIES
  submittalPlatform      String? // EMAIL|PROCORE|BUILDING_CONNECTED|BLUEBEAM|OTHER
  processNotes           String?
  engagementLeadTime     String?
  budgetCadence          String?
  submittalTurnaround    String?
  typicalSdToCd          String?
  rfiResponseExpectation String?
  timeframeNotes         String?
  // (paymentTerms moved to Client; costTier/contacts/CO-tolerance/mgmt/design-team/logistics removed — not used with clients)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ── Normalized Playbook data (Option B — queryable + bot-actionable) ───────────

model PlaybookAssignment {
  id        String   @id @default(cuid())
  clientId  String
  client    Client   @relation("ClientPlaybookAssignments", fields: [clientId], references: [id], onDelete: Cascade)
  role      String // PROPOSAL_SIGNER_STANDARDS | PROPOSAL_SIGNER_PROJECT | CONTRACT_SIGNER | INVOICING_STANDARDS | INVOICING_PROJECT | DESIGN_INTRO | GC_INTRO
  contactId String? // Contact id
  note      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([clientId, role])
}

model PlaybookDistribution {
  id           String   @id @default(cuid())
  clientId     String
  client       Client   @relation("ClientPlaybookDistribution", fields: [clientId], references: [id], onDelete: Cascade)
  event        String // BUDGETS | DESIGN_MILESTONE | FIXTURE_SCHEDULE | PHOTOMETRICS | SUBMITTALS | RFIS | CHANGE_ORDERS | SHIP_SCHEDULE | OTHER
  contactId    String? // Contact id
  freetextName String? // when not yet a CRM contact
  note         String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([clientId, event])
}

model PlaybookNote {
  id        String   @id @default(cuid())
  clientId  String
  client    Client   @relation("ClientPlaybookNotes", fields: [clientId], references: [id], onDelete: Cascade)
  topic     String // short, queryable title
  body      String   @default("") // markdown
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([clientId])
}

// Uploaded pipeline Excel files (kept as history; newest drives the live pipeline).
model PipelineUpload {
  id           String   @id @default(cuid())
  clientId     String
  client       Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  fileName     String
  fileKey      String // S3 key (reuses the qc bucket)
  rowCount     Int      @default(0)
  uploadedById String?
  createdAt    DateTime @default(now())
}

// The current, synced pipeline for a client. Re-uploads add/modify/remove by name.
model PipelineProject {
  id            String   @id @default(cuid())
  clientId      String
  client        Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  name          String
  units         Int?
  startDate     String? // ISO yyyy-mm-dd (source formats vary)
  projectType   String? // New Construction | Rehab (derived from the file's sections)
  buildingType  String?
  phase         String?
  ilcRevenue    Float?
  architect     String?
  gc            String?
  gcContact     String?
  gcEmail       String?
  address       String?
  preconManager String?
  raw           String? // JSON of the full original row
  dismissed     Boolean  @default(false) // "we're not working on it" — stays out across re-syncs
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([clientId, name])
}

// A person inside a client. Mike's People spec (2026-09-06): full name that can
// be split into first/last, two phone numbers, LinkedIn, and the two email
// timestamps that light up when email sync is built. Deal counts are derived
// from ProjectContact links, never stored.
// ── One person ───────────────────────────────────────────────────────────────
// There used to be TWO tables describing the same humans: ClientContact (people
// who work at a client) and Contact (people we know, company optional). The same
// person's last email lived on one row and their last coffee on the other, so no
// screen could show both. They are one model now.
//
// The TABLE is still called ClientContact on purpose — renaming a live table
// renames nothing else and risks every index and foreign key hanging off it, and
// nobody but Prisma ever reads the name. The MODEL name is what the code says.
model Contact {
  id                  String              @id @default(cuid())
  contactNumber       Int?                @unique // human-readable number, same idea as clientNumber
  // Archived, never deleted (Mike, 2026-09-11: "archive only for everything").
  // Set = hidden from every list, picker and count; the row and everything
  // hanging off it is kept, and Restore on the Archive page clears it.
  archivedAt          DateTime?
  archivedById        String?
  archivedBy          User?               @relation("ContactArchiver", fields: [archivedById], references: [id], onDelete: SetNull)
  // Optional: we meet people before we know where they work. Deleting a company
  // must NOT delete the human — it just unhooks them (this was Cascade when the
  // table only ever held employees of a client).
  clientId            String?
  client              Client?             @relation(fields: [clientId], references: [id], onDelete: SetNull)
  name                String
  firstName           String? // parsed from name on save; editable
  lastName            String?
  preferredName       String? // "Ryan" — used in email salutation
  title               String?
  company             String? // employer as typed (independent of clientId)
  email               String?
  phone               String? // legacy single phone — kept in sync with workPhone
  cellPhone           String?
  workPhone           String?
  linkedInUrl         String?
  // One of Mike's eight, stored as a KEY (migration 0092). The list, the
  // labels and the spelling aliases live in src/lib/contactDepartments.js.
  // NOT the ILC staff department in src/lib/departments.js — different question.
  department          String? // CORPORATE | PRECONSTRUCTION | CONSTRUCTION | PROCUREMENT | DESIGN | DEVELOPMENT | ARCHITECT | INTERIOR_DESIGN (+ legacy FINANCE)
  notes               String?
  // Relationship intelligence
  cadenceTier         String? // VIP_CLIENT | ACTIVE_DEAL | WARM_PROSPECT | PAST_CLIENT | COLD_PROSPECT
  cadenceDays         Int? // null = use tier default from RelationshipCadenceRule
  lastInPersonAt      DateTime? // most recent in-person activity (Coffee/Lunch/Golf/etc.)
  lastTouchpointAt    DateTime? // most recent ANY touchpoint
  nextCheckInAt       DateTime? // snoozed until this date (overrides cadence clock temporarily)
  // Email intelligence. Both are CACHES of the newest matching EmailContactLink
  // — kept so a list of 200 people does not have to scan the mailbox — and both
  // ignore mass sends (25+ people), calendar invites, replies and automatic
  // messages. Rebuilt by refreshContactEmailDates() in src/lib/email/recorder.js.
  lastEmailReceivedAt DateTime?
  lastEmailSentAt     DateTime?
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
  projectLinks        ProjectContact[]
  emailLinks          EmailContactLink[]
  noteLinks           NoteContact[]
  employment          ContactEmployment[]

  @@index([clientId])
  @@map("ClientContact")
}

// A person's work history, one row per job (migration 0083). Filled from text a
// salesperson pastes off the person's LinkedIn profile (source 'linkedin_paste')
// or typed by hand ('manual'); the app never reads LinkedIn itself. Meeting Prep
// reads it. Archive-only: a fresh paste archives the old pasted rows. Months are
// 1–12 and optional; isCurrent means "to present" and leaves the end blank.
model ContactEmployment {
  id           String    @id @default(cuid())
  contactId    String
  contact      Contact   @relation(fields: [contactId], references: [id], onDelete: Cascade)
  company      String
  title        String?
  startYear    Int?
  startMonth   Int?
  endYear      Int?
  endMonth     Int?
  isCurrent    Boolean   @default(false)
  position     Int       @default(0) // 0 = newest, as the profile lists them
  source       String    @default("manual") // 'linkedin_paste' | 'manual'
  createdById  String?
  archivedAt   DateTime?
  archivedById String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([contactId])
}

// Person ↔ project link. isLead marks the Lead Person on that project; every
// linked person inherits the project's win/loss counts.
model ProjectContact {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  contactId String
  contact   Contact  @relation(fields: [contactId], references: [id], onDelete: Cascade)
  isLead    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@unique([projectId, contactId])
  @@index([contactId])
}

model ClientKBSection {
  id          String               @id @default(cuid())
  clientId    String
  client      Client               @relation(fields: [clientId], references: [id], onDelete: Cascade)
  title       String               @default("Untitled Section")
  content     String               @default("")
  sortOrder   Int                  @default(0)
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
  attachments ClientKBAttachment[]
}

model ClientKBAttachment {
  id           String          @id @default(cuid())
  sectionId    String
  section      ClientKBSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  originalName String
  storedPath   String
  mimeType     String?
  size         Int
  createdAt    DateTime        @default(now())
}

model Project {
  id                            String         @id @default(cuid())
  projectNumber                 Int?           @unique
  // Archived, never deleted (Mike, 2026-09-11: "archive only for everything").
  // Set = hidden from every list, picker and count; the row and everything
  // hanging off it is kept, and Restore on the Archive page clears it.
  archivedAt                    DateTime?
  archivedById                  String?
  archivedBy                    User?          @relation("ProjectArchiver", fields: [archivedById], references: [id], onDelete: SetNull)
  name                          String
  buildingType                  String?
  location                      String?
  contactEmail                  String?
  address                       String?
  date                          String?
  budgetType                    String         @default("conceptual")
  budgetNumber                  String?        @unique
  budgetSentDate                DateTime?
  phase                         String         @default("sd")
  city                          String?
  state                         String?
  zip                           String? // 5 digits or ZIP+4 (migration 0078)
  contactName                   String? // the client-side contact; pairs with contactEmail (0078)
  status                        String         @default("DRAFT")
  serviceType                   String?
  peerReviewMatrixType          String         @default("PEER_REVIEW")
  // ── Pipeline / CRM (merged from Deal — a project IS the pipeline entity) ─────
  // The project is one source of truth across budgets, the pipeline, and the CRM.
  // Board membership is DERIVED from serviceType (Procurement = all; Design =
  // fullDesign/designAssist). Revenue reuses contractValue (Product Sale Total)
  // + designContractValue (Design Fee Total); Total Combined is their sum (never stored).
  projectType                   String? // Multi-Family, etc. (from Deal)
  procurementStage              String         @default("QUALIFIED") // Procurement board column
  designStage                   String         @default("QUALIFIED") // Design board column (dual-pipeline only); shares the Procurement stage list since 0061
  pipelineProbability           Int            @default(50) // legacy single probability (kept; = probabilityToWin)
  probabilityToWin              Int? // % chance ILC wins the job
  probabilityToMoveForward      Int? // % chance the project moves forward at all
  // Average Probability (mean of the two above) is DERIVED, never stored — computed in the sales provider.
  procurementStatus             String         @default("OPEN") // OPEN | ON_HOLD | WON | LOST | ABANDONED (COMPLETED = legacy, read-only since 0091)
  procurementStatusReason       String? // required note when set to LOST or ABANDONED
  designStatus                  String         @default("OPEN") // dual-pipeline (Full Design / Design Assist) only
  designStatusReason            String? // required note when set to LOST or ABANDONED
  expectedOrderDate             DateTime?
  // Maram 9-17: "Expected Contract Execution Date" sits ABOVE Expected Order Date
  // in the pipeline popup — the day the contract is signed, before the order lands.
  expectedContractExecutionDate DateTime?
  // Maram 9-17 / Mike 9-19: the sub-type under Project Type — a BUILDING_TYPES key from utils.js (garden, wrap, podium …).
  projectSubtype                String?
  salesOwnerId                  String? // the ONE project owner across the platform
  salesOwner                    User?          @relation("ProjectSalesOwner", fields: [salesOwnerId], references: [id])
  preconManagerId               String?
  preconManager                 User?          @relation("ProjectPreconManager", fields: [preconManagerId], references: [id])
  // ── Weekly sales meeting: discrete operational signals (Mike, 2026-07-06) ──
  proposalSentDate              DateTime? // when a proposal went out → "awaiting signature" aging
  nextActionType                String? // NEXT_ACTION_TYPES key (CALL, CHASE_SIGNATURE, …)
  nextActionOwnerId             String? // who owes the action (User id, resolved in UI)
  nextActionDueDate             DateTime? // when it's due → overdue flagging
  flagged                       Boolean        @default(false)
  flagNote                      String?
  contractValue                 Float?
  contractSignedDate            String?
  totalInvoiced                 Float?
  designContractValue           Float?
  designContractSignedDate      String?
  constructionStartDate         String?
  mepRoughInDate                String?
  constructionEndDate           String?
  currentStep                   String         @default("project-data")
  completedSteps                String         @default("[]")
  pricingSnapshot               String?
  createdAt                     DateTime       @default(now())
  updatedAt                     DateTime       @updatedAt
  createdById                   String
  createdBy                     User           @relation(fields: [createdById], references: [id])
  marketSignals                 MarketSignal[]
  clientId                      String?
  client                        Client?        @relation(fields: [clientId], references: [id])

  // -- Project team (Mike, 2026-09-09) ----------------------------------------
  // Mike: "we have six project team fields and they connect to clients." Six
  // named roles, one company each, and ALWAYS optional -- never required to mark
  // a project won.
  //
  // Six named columns rather than a role-tagged join table on purpose: he asked
  // for six fields, each holds exactly one company, and named columns make
  // "which projects is this company on the team of" a plain query with no role
  // string anyone can mistype. A seventh role later is a migration, which is the
  // cheaper problem.
  //
  // No filtering by client type, deliberately -- a developer sometimes acts as
  // their own GC, and the picker should not argue with him.
  //
  // Deleting a company clears its seat on the team; it never deletes the project.
  developerId            String?
  developer              Client? @relation("ProjectDeveloper", fields: [developerId], references: [id], onDelete: SetNull)
  generalContractorId    String?
  generalContractor      Client? @relation("ProjectGeneralContractor", fields: [generalContractorId], references: [id], onDelete: SetNull)
  electricalContractorId String?
  electricalContractor   Client? @relation("ProjectElectricalContractor", fields: [electricalContractorId], references: [id], onDelete: SetNull)
  interiorDesignerId     String?
  interiorDesigner       Client? @relation("ProjectInteriorDesigner", fields: [interiorDesignerId], references: [id], onDelete: SetNull)
  electricalEngineerId   String?
  electricalEngineer     Client? @relation("ProjectElectricalEngineer", fields: [electricalEngineerId], references: [id], onDelete: SetNull)
  architectId            String?
  architect              Client? @relation("ProjectArchitect", fields: [architectId], references: [id], onDelete: SetNull)

  lifecycleStatus String @default("ACTIVE") // PROSPECT | ACTIVE | COMPLETED | LOST

  projectData          ProjectData?
  siteFeatures         SiteFeature[]
  responses            QuestionnaireResponse[]
  shares               ProjectShare[]
  peerReviewItems      PeerReviewItem[]
  assignees            ProjectAssignee[]
  files                ProjectFile[]
  projectAccess        ProjectAccess[]
  notes                Note[]
  submittalTracker     SubmittalTracker?
  activities           ProjectActivity[]
  chatConversations    ChatConversation[]
  botDrafts            BotDraft[]                  @relation("ProjectBotDrafts")
  noteLinks            NoteProject[]               @relation("ProjectNoteLinks")
  fixtureSchedules     FixtureSchedule[]
  designBidMatrices    DesignBidMatrix[]
  standardsOverrides   ProjectStandardsOverride[]
  placedFixtures       PlacedFixture[]
  shipments            Shipment[]
  notificationConfigs  ProjectNotificationConfig[]
  notificationLogs     NotificationLog[]
  notificationQueue    NotificationQueue[]
  externalContacts     ProjectExternalContact[]
  drawingSubmissions   DrawingSubmission[]
  fixtureShares        FixtureScheduleShare[]
  unitSelections       UnitSelectionSurvey[]       @relation("ProjectUnitSelections")
  changeOrders         ChangeOrder[]
  budgetQC             BudgetQCChecklist?          @relation("ProjectBudgetQC")
  priceHistory         ProductPriceHistory[]       @relation("PriceHistory")
  emails               EmailMessage[]
  shipSchedulePushes   ShipSchedulePush[]
  rfis                 RFI[]
  rfiRoutingMode       String?                     @default("DIRECT")
  submittalOpenItems   SubmittalOpenItem[]         @relation("SubmittalOpenItems") // DIRECT|THROUGH_ARCHITECT|REVIEW_ONLY
  proposals            Proposal[]                  @relation("ProjectProposals")
  unitTypes            ProjectUnitType[]
  submissions          ConceptualSubmission[]      @relation("SubmissionDuplicateMatch")
  suggestedSubmissions ConceptualSubmission[]      @relation("SubmissionSuggestedMatch")
  calibrationSamples   CalibrationSample[]
  contactLinks         ProjectContact[]
  statusEvents         ProjectStatusEvent[]

  // A company's Related Projects reads all six of these at once.
  @@index([developerId])
  @@index([generalContractorId])
  @@index([electricalContractorId])
  @@index([interiorDesignerId])
  @@index([electricalEngineerId])
  @@index([architectId])
}

/// Every time a deal changes status on a board, one row lands here.
///
/// Mike, 2026-09-08: "We need to record the date a deal was created and that
/// status of won, lost, abandoned, etc. changed." The status columns on Project
/// only ever hold where a deal is NOW, so the day it was won was unrecoverable —
/// which is why the sales-cycle chart could never be built.
///
/// One row per BOARD, because a Full Design job is won or lost on each board
/// independently. `approximated` marks a row invented by the 0069 backfill from
/// updatedAt rather than observed: the 0061 lesson is that once a guessed date
/// is stored it is indistinguishable from a real one, so it is labelled instead.
model ProjectStatusEvent {
  id           String   @id @default(cuid())
  projectId    String
  project      Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  pipeline     String // PROCUREMENT | DESIGN
  fromStatus   String? // null on the opening row (the deal being created)
  toStatus     String // OPEN | ON_HOLD | WON | LOST | ABANDONED (COMPLETED legacy)
  reason       String? // the written reason captured when losing or abandoning
  changedAt    DateTime @default(now())
  changedById  String?
  changedBy    User?    @relation("ProjectStatusEventChangedBy", fields: [changedById], references: [id])
  approximated Boolean  @default(false)

  @@index([projectId, pipeline])
  @@index([changedAt])
}

// Access history (migration 0086, 2026-09-15): one row per change to someone's
// access, written in the same transaction as the change. See
// src/lib/accessEvents.js. Never deleted; a password is never stored here.
model UserAccessEvent {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation("UserAccessEventSubject", fields: [userId], references: [id], onDelete: Restrict)
  kind        String // CREATED | NAME | ROLE | ACTIVE | DEPARTMENT | PERMISSION | PASSWORD_RESET | MUST_CHANGE_PASSWORD
  field       String? // the permission key, on PERMISSION rows
  fromValue   String? // null on CREATED and on a department being added
  toValue     String? // null on a department being removed and on PASSWORD_RESET
  changedAt   DateTime @default(now())
  changedById String?
  changedBy   User?    @relation("UserAccessEventActor", fields: [changedById], references: [id], onDelete: SetNull)

  @@index([userId, changedAt])
  @@index([changedAt])
}

