}

model MasterType {
  code           String          @id
  description    String
  fixture_family String
  symbol_svg     String          @default("")
  is_unit_type   Boolean         @default(false)
  is_active      Boolean         @default(true)
  fixtureTypes   FixtureType[]
  ilcSpecs       ILCSpec[]
  placedFixtures PlacedFixture[]
}

model FixtureType {
  code           String                  @id
  master_type_id String
  masterType     MasterType              @relation(fields: [master_type_id], references: [code])
  family         String
  description    String?
  is_active      Boolean                 @default(true)
  placedFixtures PlacedFixture[]
  clientAnswers  ClientStandardsAnswer[]
}

model ILCSpec {
  id             String     @id @default(cuid())
  master_type_id String
  masterType     MasterType @relation(fields: [master_type_id], references: [code])
  family         String
  description    String
  manufacturer   String
  base_catalog   String
  full_catalog   String?
  variables      String?
  budget_cost    Float?
  design_notes   String?
