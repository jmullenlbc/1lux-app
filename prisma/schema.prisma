generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id                 String                     @id @default(cuid())
  email              String                     @unique
  name               String?
  passwordHash       String?
  role               String                     @default("USER")
  deptRoles          String                     @default("[]") // JSON: ["Operations","Design",...]
  // Roles: SUPER_ADMIN | COMPANY_ADMIN | USER | CLIENT_VIEWER
  // Legacy roles still supported: ILC_ADMIN (=SUPER_ADMIN), ADMIN (=COMPANY_ADMIN)
  permissions        String                     @default("{}") // JSON: { projects, clients, preCon, manufacturers, admin, knowledgeBase }
  mustChangePassword Boolean                    @default(false)
  isActive           Boolean                    @default(true)
  inviteToken        String?                    @unique
  inviteExpiry       DateTime?
  dashboardConfig    String? // JSON: { version, widgets: [{id, order, size?}] }
  createdAt          DateTime                   @default(now())
  updatedAt          DateTime                   @updatedAt
  invitedById        String?
  projects           Project[]
  clients            Client[]
  assignedProjects   ProjectAssignee[]
  uploadedFiles      ProjectFile[]
  projectAccess      ProjectAccess[]
  standardsCreated   DesignStandard[]           @relation("KBCreator")
  standardsUpdated   DesignStandard[]           @relation("KBUpdater")
  ownedDeals         Deal[]                     @relation("DealOwner")
  createdDeals       Deal[]                     @relation("DealCreator")
  salesNotes         SalesNote[]                @relation("SalesNoteCreator")
  publishedSchedules FixtureSchedule[]          @relation("SchedulePublisher")
  pushedBidMatrices  DesignBidMatrix[]          @relation("BidPusher")
  tasksCreated       Task[]                     @relation("TaskCreator")
  tasksAssigned      Task[]                     @relation("TaskAssignee")
  dashboards         Dashboard[]                @relation("DashboardCreator")
  standardsAnswers   ClientStandardsAnswer[]    @relation("AnsweredByUser")
  standardsOverrides ProjectStandardsOverride[] @relation("OverrideActivator")
  confirmedFixtures  PlacedFixture[]            @relation("FixtureConfirmer")
  drawingUploads     DrawingSubmission[]        @relation("DrawingUploader")
  fixtureShares      FixtureScheduleShare[]     @relation("FixtureShareCreator")
  changeOrdersCreated ChangeOrder[]             @relation("COCreator")
  changeOrderSends   ChangeOrderSend[]          @relation("COSender")
  changeOrderShares  ChangeOrderShare[]         @relation("COShareCreator")
  parsedEmails       EmailMessage[]             @relation("EmailParser")
  qcAssignments      BudgetQCChecklist[]        @relation("QCAssignee")
  qcItemsChecked     BudgetQCItem[]             @relation("QCItemChecker")
  assignedRFIs       RFI[]                      @relation("RFIAssignee")
  warehouseReleases  WarehouseRelease[]         @relation("WarehouseReleaser")
  approvedReleases   WarehouseRelease[]         @relation("ReleaseApprover")
  deliveryEventsCreated ManufacturerDeliveryEvent[] @relation("DeliveryEventCreator")
  shipSchedulePushes ShipSchedulePush[]         @relation("ShipPusher")
  ownedClients       Client[]                   @relation("ClientOwner")
  alerts             UserAlert[]
  // Sales Bot
  homeBaseCity       String?
  homeBaseAddress    String?
  // Email tone profile — extracted from sent email history (mbox upload)
  toneProfile        String?   // JSON: { summary, phrases[], openers[], closers[], formality, examples[] }
  toneProfileBuiltAt DateTime? // when the profile was last generated
  toneProfileSource  String?   // "gmail_mbox" | "outlook_mbox" | "manual"
  botConfig          BotConfig?
  botDrafts          BotDraft[]                 @relation("BotDraftOwner")
  schedulingRules    SchedulingRule[]           @relation("SchedulingRuleCreator")
  messageTemplates   MessageTemplate[]          @relation("TemplateCreator")
  botKnowledgeEntries BotKnowledgeEntry[]       @relation("KnowledgeCreator")
  userLocationStates  UserLocationState[]       @relation("LocationStateOwner")
  botRulesCreated    BotRule[]                  @relation("BotRuleCreator")
  submittalResponses SubmittalResponse[]        @relation("SubmittalResponseCreator")
  cadenceRulesCreated       RelationshipCadenceRule[]       @relation("CadenceRuleCreator")
  exclusionRulesCreated     ActivityExclusionRule[]         @relation("ExclusionRuleCreator")
  classificationRulesCreated ActivityClassificationRule[]   @relation("ClassificationRuleCreator")
  proposalsCreated          Proposal[]                      @relation("UserProposals")
  proposalSends             ProposalSend[]                  @relation("UserProposalSends")
  proposalTemplatesCreated  ProposalTemplate[]              @relation("UserProposalTemplates")
  proposalRatesUpdated      ProposalRate[]                  @relation("ProposalRateUpdater")
  bugReportsCreated  BugReport[] @relation("BugReportReporter")
  bugReportsAssigned BugReport[] @relation("BugReportAssignee")
}

model UserAlert {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String
  title     String
  message   String
  link      String?
  isRead    Boolean  @default(false)
  dedupeKey String?  @unique
  createdAt DateTime @default(now())
}

model BugReport {
  id            String   @id @default(cuid())
  title         String
  description   String   @default("")
  status        String   @default("NEW")        // NEW | IN_PROGRESS | FIXED
  severity      String   @default("MAJOR")      // BLOCKER | MAJOR | MINOR | COSMETIC
  module        String?
  pageUrl       String?
  projectId     String?
  expectedText  String?
  actualText    String?
  screenshotKey String?
  recordingKey  String?
  consoleJson   String   @default("[]")         // JSON string: [{level,msg,ts}]
  networkJson   String   @default("[]")         // JSON string: [{method,url,status,ts}]
  pageStateJson String?
  browserInfo   String?
  viewport      String?
  reporterId    String
  reporter      User     @relation("BugReportReporter", fields: [reporterId], references: [id])
  assigneeId    String?
  assignee      User?    @relation("BugReportAssignee", fields: [assigneeId], references: [id])
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Task {
  id          String           @id @default(cuid())
  title       String
  description String?
  status      String           @default("TODO") // TODO | IN_PROGRESS | IN_REVIEW | DONE
  priority    String           @default("MEDIUM") // LOW | MEDIUM | HIGH | URGENT
  assigneeId  String?
  createdById String
  dueDate     DateTime?
  tags        String           @default("[]") // JSON string array of menu tag ids
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  assignee    User?            @relation("TaskAssignee", fields: [assigneeId], references: [id])
  createdBy   User             @relation("TaskCreator", fields: [createdById], references: [id])
  attachments TaskAttachment[]
}

model TaskAttachment {
  id           String   @id @default(cuid())
  taskId       String
  task         Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  originalName String
  storedPath   String
  mimeType     String?
  size         Int
  createdAt    DateTime @default(now())
}

model KbCategory {
  id        String   @id @default(cuid())
  key       String   @unique
  label     String
  desc      String   @default("")
  color     String   @default("slate")
  icon      String   @default("📁")
  position  Int      @default(0)
  isBuiltIn Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model DesignStandard {
  id          String   @id @default(cuid())
  category    String
  title       String
  content     String
  severity    String   @default("REQUIRED") // REQUIRED | RECOMMENDED | NOTE
  tags        String   @default("[]")
  sourceUrl   String?
  isActive       Boolean  @default(true)
  superAdminOnly Boolean  @default(false)
  createdById    String
  updatedById    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  createdBy      User     @relation("KBCreator", fields: [createdById], references: [id])
  updatedBy      User?    @relation("KBUpdater", fields: [updatedById], references: [id])
}

model Client {
  id           String @id @default(cuid())
  clientNumber Int?   @unique
  name         String
  type         String @default("developer")
  locationType String @default("standalone")

  email   String?
  phone   String?
  website String?
  address String?
  city    String?
  state   String?

  linkedIn            String?
  primaryContact      String?
  primaryContactTitle String?
  primaryContactEmail String?
  primaryContactPhone String?

  notes String?

  tier          String?
  markets       String  @default("[]")
  developerType String?
  orgTypes      String  @default("[]")

  ownerId          String?
  owner            User?                   @relation("ClientOwner", fields: [ownerId], references: [id])
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt
  createdById      String
  createdBy        User                    @relation(fields: [createdById], references: [id])
  projects         Project[]
  contacts         ClientContact[]
  kbSections       ClientKBSection[]
  deals            Deal[]
  crmContacts      Contact[]
  salesNotes       SalesNoteClient[]
  standardsAnswers ClientStandardsAnswer[]
  playbook         ClientPlaybook?
  signals          MarketSignal[]
  aliases          ClientAlias[]
  cadenceDays      Int?    // company-level cadence override; null = use individual tier defaults
}

model ClientPlaybook {
  id      String @id @default(cuid())
  clientId String @unique
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  // Section 1 — Scope & Relationships
  projectTypes    String?  // JSON array: ['BTR','GARDEN','PODIUM','HIGHRISE','LIHTC']
  projectsPerYear Int?
  primaryMarkets  String?
  costTierNotes   String?
  architectRel    String?  // JSON: { exists, firm, contact, introStatus, notes }
  eeRel           String?  // JSON: { exists, firm, contact, introStatus, notes }
  gcRel           String?  // JSON: { exists, firm, contact, introStatus, gcModel, notes }
  primaryContactId  String?
  approverContactId String?

  // Section 3 — General Process
  engagementTiming  String?  // SD|DD|CD|BID|VARIES
  submittalPlatform String?  // EMAIL|PROCORE|BUILDING_CONNECTED|BLUEBEAM|OTHER
  coTolerance       String?  // TIGHT|NORMAL|FLEXIBLE
  mgmtStructure     String?  // CENTRAL|REGIONAL|MIXED
  hasDesignTeam     Boolean  @default(false)
  processNotes      String?

  // Section 4 — Timeframes
  engagementLeadTime     String?  // 6_PLUS|3_TO_6|1_TO_3|AT_GB|VARIES
  budgetCadence          String?  // EACH_PHASE|CD_ONLY|AS_REQUESTED|QUARTERLY
  submittalTurnaround    String?  // 3_DAYS|5_DAYS|2_WEEKS|NONE
  typicalSdToCd          String?
  rfiResponseExpectation String?  // SAME_DAY|24HR|48HR|NOT_SPECIFIED
  timeframeNotes         String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ClientContact {
  id        String   @id @default(cuid())
  clientId  String
  client    Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  name      String
  title     String?
  email     String?
  phone     String?
  createdAt DateTime @default(now())
}

model ClientKBSection {
  id          String               @id @default(cuid())
  clientId    String
  client      Client               @relation(fields: [clientId], references: [id], onDelete: Cascade)
  title       String               @default("Untitled Section")
  content     String               @default("")
  sortOrder   Int                  @default(0)
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
  attachments ClientKBAttachment[]
}

model ClientKBAttachment {
  id           String          @id @default(cuid())
  sectionId    String
  section      ClientKBSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  originalName String
  storedPath   String
  mimeType     String?
  size         Int
  createdAt    DateTime        @default(now())
}

model Project {
  id                       String    @id @default(cuid())
  projectNumber            Int?      @unique
  name                     String
  buildingType             String?
  location                 String?
  contactEmail             String?
  address                  String?
  date                     String?
  budgetType               String    @default("conceptual")
  budgetNumber             String?   @unique
  budgetSentDate           DateTime?
  phase                    String    @default("sd")
  city                     String?
  state                    String?
  status                   String    @default("DRAFT")
  serviceType              String?
  peerReviewMatrixType     String    @default("PEER_REVIEW")
  flagged                  Boolean   @default(false)
  flagNote                 String?
  contractValue            Float?
  contractSignedDate       String?
  totalInvoiced            Float?
  designContractValue      Float?
  designContractSignedDate String?
  constructionStartDate    String?
  mepRoughInDate           String?
  constructionEndDate      String?
  currentStep              String    @default("project-data")
  completedSteps           String    @default("[]")
  pricingSnapshot          String?
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt
  createdById              String
  createdBy                User      @relation(fields: [createdById], references: [id])
  clientId                 String?
  client                   Client?   @relation(fields: [clientId], references: [id])

  lifecycleStatus     String              @default("ACTIVE") // PROSPECT | ACTIVE | COMPLETED | LOST

  projectData         ProjectData?
  responses           QuestionnaireResponse[]
  shares              ProjectShare[]
  peerReviewItems     PeerReviewItem[]
  assignees           ProjectAssignee[]
  files               ProjectFile[]
  projectAccess       ProjectAccess[]
  meetingNotes        MeetingNote[]
  submittalTracker    SubmittalTracker?
  activities          ProjectActivity[]
  chatConversations   ChatConversation[]
  linkedDeals         Deal[]                      @relation("DealProject")
  fixtureSchedules    FixtureSchedule[]
  designBidMatrices   DesignBidMatrix[]
  standardsOverrides  ProjectStandardsOverride[]
  placedFixtures      PlacedFixture[]
  shipments           Shipment[]
  notificationConfigs ProjectNotificationConfig[]
  notificationLogs    NotificationLog[]
  notificationQueue   NotificationQueue[]
  externalContacts    ProjectExternalContact[]
  drawingSubmissions  DrawingSubmission[]
  fixtureShares       FixtureScheduleShare[]
  changeOrders        ChangeOrder[]
  budgetQC            BudgetQCChecklist?         @relation("ProjectBudgetQC")
  priceHistory        ProductPriceHistory[]      @relation("PriceHistory")
  emails              EmailMessage[]
  shipSchedulePushes  ShipSchedulePush[]
  rfis                RFI[]
  rfiRoutingMode      String?            @default("DIRECT")
  submittalOpenItems  SubmittalOpenItem[] @relation("SubmittalOpenItems") // DIRECT|THROUGH_ARCHITECT|REVIEW_ONLY
  proposals           Proposal[]         @relation("ProjectProposals")
  unitTypes           ProjectUnitType[]
}

model ProjectFile {
  id             String          @id @default(cuid())
  projectId      String
  project        Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tab            String
  fileType       String?
  originalName   String
  storedPath     String
  size           Int
  mimeType       String?
  tags           String?
  textContent    String?
  takeoffData    String?
  parsedAmount   Float?
  analysisData   String?
  uploadedById   String
  uploadedBy     User            @relation(fields: [uploadedById], references: [id])
  createdAt         DateTime              @default(now())
  placedFixtures    PlacedFixture[]
  rfiAttachments    RFIAttachment[]       @relation("RFIDrawing")
  drawingRevisions  DrawingRevisionFlag[] @relation("DrawingRevisionFlags")
}

model ProjectAssignee {
  id        String   @id @default(cuid())
  projectId String
  userId    String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([projectId, userId])
}

model ProjectAccess {
  id        String   @id @default(cuid())
  userId    String
  projectId String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, projectId])
}

model ProjectData {
  id        String  @id @default(cuid())
  projectId String  @unique
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  grossSf             Float?
  unitsSf             Float?
  numUnits            Int?
  numBedrooms         Int?
  numBalconies        Int?
  numBathrooms        Int?
  numVanities         Int?
  numEgressStairwells Int?
  numFans             Int?
  numAccentDownlights Int?

  numSurfaceParking Int?
  numCarports       Int?
  numGarages        Int?
  numExteriorDoors  Int?

  exteriorAmenitySf   Float?
  lotSf               Float?
  buildingFootprintSf Float?
  corridorSf          Float?
  interiorAmenitySf   Float?
  garageSf            Float?
  bohSf               Float?

  clientInitialBudget Float?
  freightPct          Float?
  warehousingPct      Float?
  salesTaxPct         Float?
  marginPct           Float?
}

model ProjectShare {
  id           String    @id @default(cuid())
  projectId    String
  project      Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  token        String    @unique @default(cuid())
  sentTo       String    @default("[]")
  message      String?
  sentAt       DateTime  @default(now())
  sentById     String
  viewCount    Int       @default(0)
  lastViewedAt DateTime?
  viewLog      String    @default("[]")
}

model SystemConfig {
  id          String   @id @default(cuid())
  key         String   @unique
  value       String
  updatedAt   DateTime @updatedAt
  updatedById String?
}

model PeerReviewItem {
  id                 String   @id @default(cuid())
  projectId          String
  project            Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  section            String   @default("units")
  typeCode           String?
  description        String?
  location           String   @default("")
  notes              String   @default("")
  internalNotes      String   @default("")
  qty                Float?
  specManufacturer   String?
  specModel          String?
  specDetails        String?
  prevQty            Float?
  qtyType            String?
  altChoices         String?
  propManufacturer   String?
  propManufacturerId String?
  propModel          String?
  propProductId      String?
  propUnitDN         Float?
  propUnitPrice      Float?
  repName            String?
  repEmail           String?
  rfqStatus          String?
  unitSavings        Float?
  totalSavings       Float?
  sortOrder          Int      @default(0)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

model QuestionnaireResponse {
  id          String   @id @default(cuid())
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  section     String
  questionKey String
  answerValue String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([projectId, section, questionKey])
}

model SubmittalTracker {
  id            String                @id @default(cuid())
  projectId     String                @unique
  project       Project               @relation(fields: [projectId], references: [id], onDelete: Cascade)
  specSection   String?
  reviewerRoles String                @default("[\"ILC\",\"Developer\",\"Architect\",\"LA\",\"ID\",\"EE\"]")
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt
  items         SubmittalItem[]
  submissions   SubmittalSubmission[]
}

model SubmittalItem {
  id                String                 @id @default(cuid())
  trackerId         String
  tracker           SubmittalTracker       @relation(fields: [trackerId], references: [id], onDelete: Cascade)
  typeCode          String
  description       String?
  location          String?
  sortOrder         Int                    @default(0)
  createdAt         DateTime               @default(now())
  versions          SubmittalItemVersion[]
  shipmentLineItems ShipmentLineItem[]
}

model SubmittalSubmission {
  id            String                 @id @default(cuid())
  trackerId     String
  tracker       SubmittalTracker       @relation(fields: [trackerId], references: [id], onDelete: Cascade)
  name          String
  submittedDate String?
  notes         String?
  createdAt     DateTime               @default(now())
  versions      SubmittalItemVersion[]
}

model SubmittalItemVersion {
  id                  String              @id @default(cuid())
  itemId              String
  item                SubmittalItem       @relation(fields: [itemId], references: [id], onDelete: Cascade)
  submissionId        String
  submission          SubmittalSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  manufacturer        String?
  modelNumber         String?
  isDiscontinued      Boolean?            // auto-flagged by extraction
  wetLocationRequired Boolean?            // auto-flagged by extraction
  createdAt           DateTime            @default(now())
  reviews             SubmittalReview[]
}

model SubmittalReview {
  id             String               @id @default(cuid())
  versionId      String
  version        SubmittalItemVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)
  reviewerRole   String
  reviewerName   String?
  status         String
  dateNoted      String?
  notes          String?
  noteCategory   String?              // FINISH|MODEL|ACCESSORY|VOLTAGE|LUMEN|WET_LOCATION|DRAWING_SYNC|DISCONTINUED|LED_TAPE|REPEAT|CODE|BOILERPLATE|OTHER
  isExtracted    Boolean              @default(false)  // true = auto-populated from PDF
  pageNumber     Int?                 // page in source PDF where note was found
  createdAt      DateTime             @default(now())
  createdById    String?
  response       SubmittalResponse?
}

// ILC's drafted response to a reviewer note
model SubmittalResponse {
  id           String          @id @default(cuid())
  reviewId     String          @unique
  review       SubmittalReview @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  body         String          // ILC's response text
  status       String          @default("DRAFT")  // DRAFT | APPROVED | SENT
  generatedBy  String          @default("AI")     // "AI" | userId
  editedAt     DateTime?
  approvedAt   DateTime?
  createdById  String?
  createdBy    User?           @relation("SubmittalResponseCreator", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  @@index([reviewId])
}

model SubmittalOpenItem {
  id                String           @id @default(cuid())
  projectId         String
  project           Project          @relation("SubmittalOpenItems", fields: [projectId], references: [id], onDelete: Cascade)
  typeCode          String           // fixture type code (D4, EL2, etc.)
  noteCategory      String           // from REVIEW_CATEGORIES
  responsibleParty  String           // ARCH|EE|ID|CONTRACTOR|ILC|OWNERSHIP
  noteText          String           // latest note text
  openedRound       Int              @default(1)
  closedRound       Int?             // null = still open
  isRepeat          Boolean          @default(false)  // open 2+ rounds
  previousItemId    String?          // self-ref to prior round's open item
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  @@index([projectId])
  @@index([projectId, typeCode])
}

model ProjectActivity {
  id          String   @id @default(cuid())
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId      String
  userName    String?
  userEmail   String?
  type        String
  description String
  metadata    String?
  createdAt   DateTime @default(now())
}

model ChatConversation {
  id        String        @id @default(cuid())
  projectId String
  project   Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title     String?
  createdAt DateTime      @default(now())
  messages  ChatMessage[]
}

model ChatMessage {
  id             String           @id @default(cuid())
  conversationId String
  conversation   ChatConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role           String
  content        String
  createdAt      DateTime         @default(now())
}

model MeetingNote {
  id                String   @id @default(cuid())
  projectId         String
  project           Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title             String   @default("")
  content           String   @default("")
  meetingDate       String?
  meetingLink       String?
  attendees         String?
  isExternalVisible Boolean  @default(false)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model Manufacturer {
  id              String                @id @default(cuid())
  numericId       Int                   @unique
  name            String
  acctLastUpdated    String?
  setupToSell        Boolean               @default(false)
  defaultDiscountPct Float?                // e.g. 0.50 = 50% off MSRP. Used in Settings → Master Pricing.
  terms           String?
  credit          Float?
  notes           String?
  accountingEmail String?
  ffa             Float?
  paymentInfo     String?
  website         String?
  mainPhone       String?
  address         String?
  address2        String?
  city            String?
  state           String?
  zip             String?
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt
  products        ManufacturerProduct[]
}

model ManufacturerProduct {
  id             String       @id @default(cuid())
  numericId      Int          @unique
  manufacturerId String
  manufacturer   Manufacturer @relation(fields: [manufacturerId], references: [id], onDelete: Cascade)
  partNumber     String
  description    String?
  finish         String?
  cct            String?
  wattage        Float?
  dimming        String?
  voltage        String?
  mounting       String?
  fixtureType    String?
  cost           Float?
  salePrice      Float?
  notes          String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([manufacturerId, partNumber])
}

model Deal {
  id                String    @id @default(cuid())
  dealNumber        Int       @unique
  title             String
  pipeline          String
  stage             String
  dealStatus        String    @default("OPEN")
  designStatus      String    @default("OPEN")
  projectStatus     String    @default("ACTIVE")
  city              String?
  state             String?
  buildingType      String?
  numberOfUnits     Int?
  projectType       String?
  serviceType       String?
  totalRevenue      Float?
  designFeeTotal    Float?
  probability       Int       @default(50)
  expectedOrderDate DateTime?
  notes             String?
  nextActionText    String?
  nextActionDue     DateTime?
  wonAt             DateTime?
  lostAt            DateTime?
  lostReason        String?

  linkedDealId    String?
  linkedDeal      Deal?    @relation("DealLink", fields: [linkedDealId], references: [id])
  linkedDeals     Deal[]   @relation("DealLink")
  linkedProjectId String?
  linkedProject   Project? @relation("DealProject", fields: [linkedProjectId], references: [id])
  clientId        String?
  client          Client?  @relation(fields: [clientId], references: [id], onDelete: SetNull)
  ownerId         String?
  owner           User?    @relation("DealOwner", fields: [ownerId], references: [id])
  createdById     String
  createdBy       User     @relation("DealCreator", fields: [createdById], references: [id])
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  contacts   DealContact[]
  activities DealActivity[]
  salesNotes SalesNoteDeal[]
  signalTags MarketSignalDeal[]
  botDrafts  BotDraft[]         @relation("DealBotDrafts")
  proposals  Proposal[]         @relation("ProposalDeal")
}

model DealContact {
  id        String   @id @default(cuid())
  dealId    String
  deal      Deal     @relation(fields: [dealId], references: [id], onDelete: Cascade)
  contactId String
  contact   Contact  @relation(fields: [contactId], references: [id], onDelete: Cascade)
  role      String                          // legacy company-type (DEVELOPER, ARCHITECT, etc.)
  dealRole  String?                         // free-form personal role on this deal
  dealNotes String?                         // e.g. "Handles approvals", "CC only"
  isPrimary Boolean  @default(false)        // bot emails this person; only one per deal
  createdAt DateTime @default(now())

  @@unique([dealId, contactId])
}

model Contact {
  id               String              @id @default(cuid())
  contactNumber    Int                 @unique
  clientId         String?
  client           Client?             @relation(fields: [clientId], references: [id], onDelete: SetNull)
  name             String
  title            String?
  email            String?
  phone            String?
  notes            String?
  linkedInUrl      String?                       // for LinkedIn automation (Phase C)
  preferredName    String?                       // "Ryan" — used in email salutation
  company          String?                       // employer as typed (independent of clientId)
  // Relationship intelligence
  cadenceTier      String?                       // VIP_CLIENT | ACTIVE_DEAL | WARM_PROSPECT | PAST_CLIENT | COLD_PROSPECT
  cadenceDays      Int?                          // null = use tier default from RelationshipCadenceRule
  lastInPersonAt   DateTime?                     // most recent in-person activity (Coffee/Lunch/Golf/etc.)
  lastTouchpointAt DateTime?                     // most recent ANY touchpoint
  nextCheckInAt    DateTime?                     // snoozed until this date (overrides cadence clock temporarily)
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  dealContacts     DealContact[]
  noteContacts     SalesNoteContact[]
}

model SalesNote {
  id           String              @id @default(cuid())
  noteNumber   Int                 @unique
  title        String              @default("")
  body         String              @default("")
  meetingDate  DateTime?
  attendees    String              @default("[]")    // legacy JSON string for free-text names
  calendarRef  String?
  activityType           String?   // COFFEE | LUNCH | HAPPY_HOUR | GOLF | SITE_VISIT | CALL | EMAIL | EVENT | OTHER
  isInPerson             Boolean   @default(false)   // auto-set true for Coffee/Lunch/HappyHour/Golf/SiteVisit
  classificationSource   String?   // keyword | rule | ai | manual — how activityType was determined
  classificationConfidence Int?    // 0-100 — AI confidence score when source=ai
  isPublished            Boolean   @default(false)   // false = draft (no automations); true = complete, bot can use
  publishedAt            DateTime? // when note was published
  createdById  String
  createdBy    User                @relation("SalesNoteCreator", fields: [createdById], references: [id])
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  clients      SalesNoteClient[]
  deals        SalesNoteDeal[]
  contacts     SalesNoteContact[]
}

model SalesNoteContact {
  id          String    @id @default(cuid())
  salesNoteId String
  salesNote   SalesNote @relation(fields: [salesNoteId], references: [id], onDelete: Cascade)
  contactId   String
  contact     Contact   @relation(fields: [contactId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())

  @@unique([salesNoteId, contactId])
}

model SalesNoteClient {
  id          String    @id @default(cuid())
  salesNoteId String
  salesNote   SalesNote @relation(fields: [salesNoteId], references: [id], onDelete: Cascade)
  clientId    String
  client      Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())

  @@unique([salesNoteId, clientId])
}

model SalesNoteDeal {
  id          String    @id @default(cuid())
  salesNoteId String
  salesNote   SalesNote @relation(fields: [salesNoteId], references: [id], onDelete: Cascade)
  dealId      String
  deal        Deal      @relation(fields: [dealId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())

  @@unique([salesNoteId, dealId])
}

model DealActivity {
  id        String   @id @default(cuid())
  dealId    String
  deal      Deal     @relation(fields: [dealId], references: [id], onDelete: Cascade)
  userId    String
  userName  String?
  type      String
  body      String
  metadata  String?
  createdAt DateTime @default(now())
}

model FixtureSchedule {
  id                String                @id @default(cuid())
  projectId         String
  project           Project               @relation(fields: [projectId], references: [id], onDelete: Cascade)
  state             String                @default("DRAFT")
  version           Int                   @default(0)
  publishedAt       DateTime?
  publishedById     String?
  publishedBy       User?                 @relation("SchedulePublisher", fields: [publishedById], references: [id])
  submissionTag     String?
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt
  items             FixtureScheduleItem[]
  designBidMatrices DesignBidMatrix[]
}

model FixtureScheduleItem {
  id             String                @id @default(cuid())
  scheduleId     String
  schedule       FixtureSchedule       @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  type           String                @default("")
  location       String                @default("")
  description    String                @default("")
  manufacturer   String?
  catalogNumber  String?
  finish         String?
  cct            String?
  lumens         String?
  wattage        String?
  voltage        String?
  dimming        String?
  mounting       String?
  notes          String?
  internalNotes  String?
  sortOrder      Int                   @default(0)
  isAlternate    Boolean               @default(false)
  alternateOf    String?
  aiFlagged      Boolean               @default(false)
  aiConfidence          Float?
  drawingSheetReference String?          // e.g. 'EL-101 — Level 1 Lighting Plan'
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt
