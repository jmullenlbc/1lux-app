  is_default     Boolean    @default(false)
  tier           String     @default("STANDARD")
  is_active      Boolean    @default(true)
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
}

model ClientStandardsAnswer {
  id             String       @id @default(cuid())
  clientId       String
  client         Client       @relation(fields: [clientId], references: [id], onDelete: Cascade)
  section        String
  subsection     String
  question_key   String
  input_type     String
  fixture_family String?
  answer_value   String?
  answer_note    String?
  type_code      String?
  fixtureType    FixtureType? @relation(fields: [type_code], references: [code])
  resolved_sku   String?
  adder_flag     Boolean      @default(false)
  adder_prompt   String?
  reference_key  String?
  projectType    String       @default("")  // "" = global | "BTR"|"GARDEN"|"PODIUM"|"HIGHRISE"|"LIHTC"
  region         String       @default("")  // "" = all regions | client-defined key e.g. "AZ_TX"
  source         String       @default("MANUAL")  // MANUAL | CASCADE
  answeredById   String?
  answeredBy     User?        @relation("AnsweredByUser", fields: [answeredById], references: [id])
  answered_at    DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([clientId, question_key, projectType, region])
}

model ProjectStandardsOverride {
  id             String   @id @default(cuid())
  projectId      String
  project        Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  question_key   String
  override_value String
  activatedById  String
  activatedBy    User     @relation("OverrideActivator", fields: [activatedById], references: [id])
  activated_at   DateTime @default(now())
  note           String?
}

model PlacedFixture {
  id             String       @id @default(cuid())
  drawing_id     String
  drawing        ProjectFile  @relation(fields: [drawing_id], references: [id], onDelete: Cascade)
  projectId      String
  project        Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  page_number    Int          @default(1)
  x              Float
  y              Float
  ai_suggested_x Float?
  ai_suggested_y Float?
  master_type_id String
  masterType     MasterType   @relation(fields: [master_type_id], references: [code])
  type_code      String?
  fixtureType    FixtureType? @relation(fields: [type_code], references: [code])
  status         String       @default("SUGGESTED")
  unit_type      String?
  room_type      String?
  confirmedById  String?
  confirmedBy    User?        @relation("FixtureConfirmer", fields: [confirmedById], references: [id])
  confirmed_at   DateTime?
  note           String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
}

model DesignBidMatrixItem {
  id                 String               @id @default(cuid())
  matrixId           String
  matrix             DesignBidMatrix      @relation(fields: [matrixId], references: [id], onDelete: Cascade)
  sourceItemId       String?
  sourceItem         FixtureScheduleItem? @relation(fields: [sourceItemId], references: [id])
  type               String               @default("")
  description        String               @default("")
  locationTag        String?
  manufacturer       String?
  partNumber         String?
  salesRep           String?
  rfqStatus          String?
  qty                Int?
  qtyType            String?
  dnPerUnit          Float?
  cnPerUnit          Float?
  cnTotal            Float?
  pricingLastUpdated DateTime?
  notes              String?
  internalNotes      String?
  sortOrder          Int                  @default(0)
  isArchived         Boolean              @default(false)
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
}

model Shipment {
  id             String             @id @default(cuid())
  project_id     String
  project        Project            @relation(fields: [project_id], references: [id], onDelete: Cascade)
  manufacturer      String
  poDate            DateTime?
  leadTimeWeeks     String?
  esdDate           DateTime?
  trackingNumber    String?
  deliveredDate     DateTime?
  status            String             @default("PO_PLACED")
  destinationType   String             @default("WAREHOUSE")  // WAREHOUSE | DIRECT_TO_SITE
  notes             String?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  lineItems         ShipmentLineItem[]
}

model ShipmentLineItem {
  id               String             @id @default(cuid())
  shipment_id      String
  shipment         Shipment           @relation(fields: [shipment_id], references: [id], onDelete: Cascade)
  fixtureType      String
  description      String
  catalogNo        String?
  qty              Int                @default(1)
  qtyType          String?
  fixtureStatus    String?
  notes            String?
  submittalItemId  String?
  submittalItem    SubmittalItem?     @relation(fields: [submittalItemId], references: [id], onDelete: SetNull)
  // Push-populated fields
  sortOrder        Int                @default(0)
  sourceItemId     String?            // DesignBidMatrixItem.id or PeerReviewItem.id
  sourceType       String?            // "DESIGN_BID" | "PEER_REVIEW" | "CHANGE_ORDER" | "MANUAL"
  sourceBatchLabel String?            // "Initial Order", "CO-00003 Supplemental", etc.
  propManufacturer String?            // proposed mfr from bid (display only, no pricing)
  propModel        String?            // proposed part # from bid
  leadTimeWeeks    String?            // per-item lead time override (falls back to shipment-level)
  esdDate          DateTime?          // per-item ESD override (falls back to shipment-level)
  trackingNumber   String?            // per-item tracking number
  isRemoved        Boolean                    @default(false)
  releases         WarehouseRelease[]
  deliveryEvents   ManufacturerDeliveryEvent[]
  createdAt        DateTime                   @default(now())
  updatedAt        DateTime                   @updatedAt
}

model WarehouseRelease {
  id                      String       @id @default(cuid())
  lineItemId              String
  lineItem                ShipmentLineItem @relation(fields: [lineItemId], references: [id], onDelete: Cascade)
  qty                     Int          // qty requested (legacy: qty released)
  releasedById            String?      // null when PENDING; set to approving User on APPROVED
  releasedBy              User?        @relation("WarehouseReleaser", fields: [releasedById], references: [id])
  notes                   String?
  releasedAt              DateTime     @default(now())
  // Approval workflow fields (added for portal release request flow)
  status                  String       @default("APPROVED")  // PENDING | APPROVED | DECLINED
  requestedAt             DateTime     @default(now())
  requestedByPortalUserId String?
  requestedByPortalUser   PortalUser?  @relation("PortalReleaseRequests", fields: [requestedByPortalUserId], references: [id])
  approvedAt              DateTime?
  approvedById            String?
  approvedBy              User?        @relation("ReleaseApprover", fields: [approvedById], references: [id])
  qtyReleased             Int?         // set on approval; may differ from qty if ILC adjusts

  @@index([lineItemId])
}

model ManufacturerDeliveryEvent {
  id             String           @id @default(cuid())
  lineItemId     String
  lineItem       ShipmentLineItem @relation(fields: [lineItemId], references: [id], onDelete: Cascade)
  deliveryDate   DateTime
  carrier        String?
  trackingNumber String?
  qtyReceived    Int
  notes          String?
  createdById    String
  createdBy      User             @relation("DeliveryEventCreator", fields: [createdById], references: [id])
  createdAt      DateTime         @default(now())

  @@index([lineItemId])
}

model ShipSchedulePush {
  id            String   @id @default(cuid())
  projectId     String
  project       Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  sourceType    String   // "DESIGN_BID" | "PEER_REVIEW" | "CHANGE_ORDER"
  sourceVersion Int?     // bid matrix version number
  sourceCoId    String?  // if pushed from a CO
  pushedById    String
  pushedBy      User     @relation("ShipPusher", fields: [pushedById], references: [id])
  pushedAt      DateTime @default(now())
  summary       String?  // JSON { added, updated, removed }

  @@index([projectId])
}

model ProjectNotificationConfig {
  id               String   @id @default(cuid())
  project_id       String
  project          Project  @relation(fields: [project_id], references: [id], onDelete: Cascade)
  notificationType String
  externalEmails   String   @default("")
  enabled          Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

