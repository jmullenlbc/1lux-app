// Sporadic exterior site features (Mike 2026-09-16, migration 0089): dog parks,
// courtyards, playgrounds, tennis / pickleball courts, turf play areas. One
// LIVE row per kind per project; a new drawing read or a typed value archives
// the old row and writes a fresh one (archive-only, never deleted — see
// src/lib/archive.js NEVER_DELETED). Count kinds fill `count`; the linear kinds
// (courtyard, turf play) fill `lengthFt` with count 1. Priced as their own
// fixture packages by src/lib/siteFeatures.js — never folded into the amenity
// SF, parking or carport lines. Structured rows, not a JSON blob, so a bot can
// ask "which jobs have a dog park".
model SiteFeature {
  id         String    @id @default(cuid())
  projectId  String
  project    Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  type       String // dogPark | courtyard | playground | tennisCourt | pickleballCourt | turfPlay
  count      Int?
  lengthFt   Float?
  source     String // drawing | typed
  sheet      Int? // 1-based sheet number the reading came from (drawing source)
  label      String? // the words on the sheet, when read off a drawing
  createdAt  DateTime  @default(now())
  archivedAt DateTime?

  @@index([projectId, archivedAt])
}

