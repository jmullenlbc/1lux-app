// ── Unified Note (merges SalesNote + project MeetingNote) ─────────────────────
// noteType discriminates the two; each screen renders its own UI filtered by it.
// One table → cross-searchable, and a single feed for the bot follow-up pipeline.
model Note {
  id           String    @id @default(cuid())
  noteNumber   Int?      @unique
  // Archived, never deleted (Mike, 2026-09-11: "archive only for everything").
  // Set = hidden from every list, picker and count; the row and everything
  // hanging off it is kept, and Restore on the Archive page clears it.
  archivedAt   DateTime?
  archivedById String?
  archivedBy   User?     @relation("NoteArchiver", fields: [archivedById], references: [id], onDelete: SetNull)
  noteType     String    @default("SALES") // SALES | PROJECT_MEETING
  title        String    @default("")
  body         String    @default("")
  meetingDate  DateTime?
  attendees    String    @default("[]")
  calendarRef  String?

  // sales-specific
  // MEAL replaced LUNCH on 2026-09-07 (one category for breakfast, lunch and
  // dinner). Old rows still say LUNCH until migration 0066 rewrites them, and
  // normalizeActivityType() in src/lib/calendar/inPerson.js maps it forward.
  activityType             String? // COFFEE | MEAL | HAPPY_HOUR | GOLF | SITE_VISIT | TRAVEL | CALL | EMAIL | EVENT | OTHER
  isInPerson               Boolean   @default(false)
  classificationSource     String? // keyword | rule | ai | manual
  classificationConfidence Int?
  isPublished              Boolean   @default(false)
  publishedAt              DateTime?

  // project-meeting-specific
  meetingLink       String?
  isExternalVisible Boolean @default(false)

  // links (a note can attach to a project AND/OR clients/deals/contacts)
  projectId   String?
  project     Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdById String?
  createdBy   User?    @relation("NoteCreator", fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  contacts      NoteContact[]
  clients       NoteClient[]
  projects      NoteProject[]
  actions       NoteAction[]
  meetingBriefs MeetingBrief[]

  // The calendar sync looks a note up by the event's own id on every pass, so
  // that lookup gets an index. Not unique: a manually typed calendarRef could
  // repeat, and a duplicate must never fail the sync.
  @@index([calendarRef])
}

// Structured items the AI extracts from a note's prose: ACTIONs (→ bot follow-ups)
// and INTEL (facts about a person/company). type comes from the action taxonomy.
model NoteAction {
  id           String    @id @default(cuid())
  noteId       String
  note         Note      @relation(fields: [noteId], references: [id], onDelete: Cascade)
  kind         String    @default("ACTION") // ACTION | INTEL
  type         String // taxonomy id (INTRO_OUTBOUND, SETUP_MEAL, …)
  rawText      String    @default("") // the original line
  detail       String? // normalized one-liner
  contactId    String? // soft link to a CRM Contact (if matched)
  contactName  String? // person as written (if unmatched)
  targetName   String? // intro target / third party
  company      String?
  dueDate      DateTime?
  reminderDays Int? // per-item override (e.g. Expect-intro wait) — null = use the type default
  status       String    @default("SUGGESTED") // SUGGESTED | CONFIRMED | DONE | DISMISSED
  source       String    @default("ai") // ai | manual
  confirmedAt  DateTime? // when a human confirmed it
  executedAt   DateTime? // when the bot acted (draft created / reminder fired)
  remindAt     DateTime? // for EXPECT_INTRO: when to remind if the intro hasn't happened
  remindedAt   DateTime? // when the reminder was actually delivered — without this the
  //   daily sweep re-alerts every day forever, because remindAt
  //   stays in the past once it passes
  botDraftId   String? // loose ref to the BotDraft this action produced
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

// Meeting Prep (migration 0082). A brief built for one sales note, ahead of the
// meeting: the facts the app already holds about the people and companies on
// the note, and 3–5 talking points that each cite the facts they rest on.
// Internal only — never shown to a CLIENT_VIEWER, and it never carries a price.
// Every refresh adds a new brief; the screen shows the latest one.
model MeetingBrief {
  id          String   @id @default(cuid())
  noteId      String
  note        Note     @relation(fields: [noteId], references: [id], onDelete: Cascade)
  createdById String? // soft link to the User who asked
  status      String   @default("ok") // ok | no_points | error
  model       String?
  error       String?
  createdAt   DateTime @default(now())

  facts  MeetingBriefFact[]
  points MeetingBriefPoint[]

  @@index([noteId, createdAt])
}

// One fact the brief was built from, numbered F1, F2… so a talking point can
// point back at it. sourceKind/sourceId say which record it came from.
model MeetingBriefFact {
  id         String       @id @default(cuid())
  briefId    String
  brief      MeetingBrief @relation(fields: [briefId], references: [id], onDelete: Cascade)
  ref        String // "F3"
  block      String // client | people | deals | followups | intel | changeOrders | rfis | news | standards | history
  position   Int
  text       String
  sourceKind String? // Client | Contact | Project | NoteAction | ChangeOrder | RFI | MarketSignal | Note
  sourceId   String?

  citations MeetingBriefCitation[]

  @@index([briefId])
}

model MeetingBriefPoint {
  id       String       @id @default(cuid())
  briefId  String
